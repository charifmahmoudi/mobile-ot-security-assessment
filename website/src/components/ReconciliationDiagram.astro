---
import type { Lang } from '../lib/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const fr = lang === 'fr';
const rows = [
  { asset:'PLC-P04', expected: fr ? 'contrôleur attendu' : 'expected controller', evidence:'OBS-014', evidenceText: fr ? 'identité forte' : 'strong identity evidence', state: fr ? 'CORROBORÉ' : 'CORROBORATED', tone:'success' },
  { asset:'RTU-03', expected: fr ? 'RTU attendu' : 'expected RTU', evidence:'OBS-021', evidenceText: fr ? 'identité partielle' : 'partial identity evidence', state:'PROBABLE', tone:'amber' },
  { asset:'PLC-P07', expected: fr ? 'modèle A attendu' : 'expected model A', evidence:'OBS-027', evidenceText: fr ? 'modèle B observé' : 'observed model B', state: fr ? 'CONFLIT' : 'CONFLICT', tone:'danger' },
  { asset:'HMI-02', expected: fr ? 'HMI attendu' : 'expected HMI', evidence:'—', evidenceText: fr ? 'aucune preuve adéquate' : 'no adequate evidence', state: fr ? 'NON OBSERVÉ' : 'NOT OBSERVED', tone:'muted' },
  { asset:'—', expected: fr ? 'aucun enregistrement attendu' : 'no expected record', evidence:'OBS-031', evidenceText: fr ? 'endpoint sans correspondance' : 'unmatched endpoint', state: fr ? 'INATTENDU' : 'UNEXPECTED', tone:'blue' },
];
const toneClasses = {
  success: 'border-success/40 bg-pale-teal text-success',
  amber: 'border-amber/40 bg-pale-amber text-amber',
  danger: 'border-danger/40 bg-white text-danger',
  muted: 'border-border bg-surface text-muted',
  blue: 'border-blue/40 bg-pale-blue text-blue',
};
---
<figure class="app-frame overflow-hidden bg-white">
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-border bg-surface px-5 py-4">
    <div>
      <p class="text-sm font-bold text-navy">{fr ? 'Inventaire attendu → preuve → état revu' : 'Expected inventory → evidence → reviewed state'}</p>
      <p class="mt-1 text-xs text-muted">{fr ? 'Une preuve faible reste faible. Un conflit reste visible.' : 'Weak evidence stays weak. Conflicts stay visible.'}</p>
    </div>
    <span class="status-chip border-blue/25 bg-pale-blue text-blue">{fr ? 'Réconciliation fondée sur les preuves' : 'Evidence-backed reconciliation'}</span>
  </div>
  <div class="overflow-x-auto p-4 sm:p-6">
    <div class="min-w-[820px]">
      <div class="grid grid-cols-[1fr_54px_1fr_54px_.82fr] px-2 pb-3 text-[11px] font-black uppercase tracking-[.12em] text-muted">
        <span>{fr ? 'Inventaire attendu' : 'Expected inventory'}</span><span></span><span>{fr ? 'Preuve approuvée' : 'Approved evidence'}</span><span></span><span>{fr ? 'État revu' : 'Reviewed state'}</span>
      </div>
      <div class="space-y-3">
        {rows.map((row) => (
          <div class="grid grid-cols-[1fr_54px_1fr_54px_.82fr] items-stretch">
            <div class="rounded-[10px] border border-border bg-surface px-4 py-3"><strong class="block text-sm text-navy">{row.asset}</strong><span class="mt-1 block text-xs text-muted">{row.expected}</span></div>
            <div class="grid place-items-center text-lg font-black text-blue">→</div>
            <div class="rounded-[10px] border border-border bg-white px-4 py-3"><strong class="block text-sm text-navy">{row.evidence}</strong><span class="mt-1 block text-xs text-muted">{row.evidenceText}</span></div>
            <div class="grid place-items-center text-lg font-black text-blue">→</div>
            <div class={`grid place-items-center rounded-[10px] border px-4 py-3 text-xs font-black tracking-[.06em] ${toneClasses[row.tone]}`}>{row.state}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</figure>
