---
interface Props { href?: string }
const { href = import.meta.env.BASE_URL } = Astro.props;
---
<a href={href} class="inline-flex items-center gap-3 font-semibold tracking-[-0.02em] text-white no-underline" aria-label="Atlas OT Scout">
  <span class="relative grid size-9 place-items-center rounded-[9px] border border-aqua/45 bg-aqua/10 text-sm font-black text-white">
    A
    <span class="absolute bottom-1 right-1 size-1.5 rounded-full bg-aqua"></span>
    <span class="sr-only">tlas</span>
  </span>
  <span class="leading-none">Atlas <span class="font-normal text-white/62">OT Scout</span></span>
</a>
