---
import Brand from './Brand.astro';
import { bookingUrl, repo, sitePath, wiki, type Lang, type Page } from '../lib/site';

interface Props { lang: Lang; page: Page }
const { lang, page } = Astro.props;
const fr = lang === 'fr';
const base = import.meta.env.BASE_URL;
const switchLang: Lang = fr ? 'en' : 'fr';
const switchHref = sitePath(base, switchLang, page);
const home = sitePath(base, lang, 'home');
const safety = sitePath(base, lang, 'safety');
const pilot = sitePath(base, lang, 'pilot');
---
<header class="sticky top-0 z-50 border-b border-aqua/15 bg-navy text-white shadow-[0_2px_12px_rgba(11,31,51,.18)]">
  <div class="mx-auto flex h-[68px] max-w-7xl items-center justify-between px-5 sm:px-8">
    <Brand href={home} />
    <nav class="hidden items-center gap-6 text-sm md:flex" aria-label={fr ? 'Navigation principale' : 'Primary navigation'}>
      <a class="text-white/72 transition hover:text-white" href={`${home}#project`}>{fr ? 'Le projet' : 'The project'}</a>
      <a class="text-white/72 transition hover:text-white" href={`${home}#case`}>{fr ? 'Le cas' : 'The case'}</a>
      <a class="text-white/72 transition hover:text-white" href={safety}>{fr ? 'Sécurité' : 'Safety'}</a>
      <a class="text-white/72 transition hover:text-white" href={pilot}>{fr ? 'Évaluation' : 'Evaluation'}</a>
      <a class="text-white/72 transition hover:text-white" href={repo}>GitHub</a>
      <a class="rounded-[8px] border border-aqua/30 px-2.5 py-2 text-xs font-black tracking-[.08em] text-aqua transition hover:bg-aqua/10" href={switchHref} lang={switchLang} hreflang={switchLang}>{fr ? 'EN' : 'FR'}</a>
      <a class="rounded-[9px] bg-blue px-4 py-2.5 font-semibold text-white transition hover:bg-white hover:text-navy" href={bookingUrl} target="_blank" rel="noreferrer">{fr ? "Évaluer l'adéquation" : 'Assess fit'}</a>
    </nav>
    <details class="relative md:hidden">
      <summary class="cursor-pointer list-none rounded-[9px] border border-aqua/30 px-3 py-2 text-sm text-white">Menu</summary>
      <nav class="absolute right-0 mt-3 grid w-72 gap-1 rounded-[10px] border border-border bg-white p-2 text-navy shadow-xl" aria-label={fr ? 'Navigation mobile' : 'Mobile navigation'}>
        <a class="rounded-lg px-3 py-2 hover:bg-pale-blue" href={`${home}#project`}>{fr ? 'Le projet' : 'The project'}</a>
        <a class="rounded-lg px-3 py-2 hover:bg-pale-blue" href={`${home}#case`}>{fr ? 'Le cas maintenance' : 'The maintenance case'}</a>
        <a class="rounded-lg px-3 py-2 hover:bg-pale-blue" href={safety}>{fr ? 'Sécurité & maîtrise' : 'Safety & control'}</a>
        <a class="rounded-lg px-3 py-2 hover:bg-pale-blue" href={pilot}>{fr ? 'Évaluation méthodologique' : 'Methodology evaluation'}</a>
        <a class="rounded-lg px-3 py-2 hover:bg-pale-blue" href={wiki}>Wiki</a>
        <a class="rounded-lg px-3 py-2 hover:bg-pale-blue" href={repo}>GitHub</a>
        <a class="mt-1 rounded-lg border border-border px-3 py-2 font-bold text-blue hover:bg-pale-blue" href={switchHref} lang={switchLang} hreflang={switchLang}>{fr ? 'English' : 'Français'}</a>
        <a class="rounded-lg bg-blue px-3 py-2 font-bold text-white" href={bookingUrl} target="_blank" rel="noreferrer">{fr ? "Évaluer l'adéquation" : 'Assess fit'}</a>
      </nav>
    </details>
  </div>
</header>
