---
import Brand from './Brand.astro';
const base = import.meta.env.BASE_URL;
const repo = 'https://github.com/charifmahmoudi/mobile-ot-security-assessment';
const wiki = `${repo}/wiki`;
---
<header class="sticky top-0 z-50 border-b border-white/10 bg-ink/95 text-white backdrop-blur">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-5 sm:px-8">
    <Brand />
    <nav class="hidden items-center gap-7 text-sm md:flex" aria-label="Primary navigation">
      <a class="text-white/72 transition hover:text-white" href={`${base}#product`}>Product</a>
      <a class="text-white/72 transition hover:text-white" href={`${base}safety/`}>Safety &amp; Trust</a>
      <a class="text-white/72 transition hover:text-white" href={`${base}pilot/`}>Pilot</a>
      <a class="text-white/72 transition hover:text-white" href={wiki}>Wiki</a>
      <a class="text-white/72 transition hover:text-white" href={repo}>GitHub</a>
      <a class="rounded-full bg-atlas px-4 py-2 font-semibold text-ink transition hover:brightness-110" href={`${base}pilot/`}>Review pilot scope</a>
    </nav>
    <details class="relative md:hidden">
      <summary class="cursor-pointer list-none rounded-lg border border-white/15 px-3 py-2 text-sm text-white/80">Menu</summary>
      <nav class="absolute right-0 mt-3 grid w-60 gap-1 rounded-2xl border border-white/10 bg-graphite p-3 shadow-2xl" aria-label="Mobile navigation">
        <a class="rounded-xl px-3 py-2 hover:bg-white/5" href={`${base}#product`}>Product</a>
        <a class="rounded-xl px-3 py-2 hover:bg-white/5" href={`${base}safety/`}>Safety &amp; Trust</a>
        <a class="rounded-xl px-3 py-2 hover:bg-white/5" href={`${base}pilot/`}>Pilot</a>
        <a class="rounded-xl px-3 py-2 hover:bg-white/5" href={wiki}>Wiki</a>
        <a class="rounded-xl px-3 py-2 hover:bg-white/5" href={repo}>GitHub</a>
      </nav>
    </details>
  </div>
</header>
