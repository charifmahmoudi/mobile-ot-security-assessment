---
const base = import.meta.env.BASE_URL;
---
<div class="product-media">
  <figure class="app-frame app-shadow overflow-hidden">
    <div class="flex items-center justify-between border-b border-border bg-white px-4 py-3">
      <div class="flex items-center gap-2">
        <span class="size-2 rounded-full bg-blue"></span>
        <span class="text-xs font-semibold text-text">Atlas OT Scout</span>
      </div>
      <span class="text-[11px] font-medium uppercase tracking-[0.12em] text-muted">CI-recorded application</span>
    </div>
    <img class="block aspect-video w-full object-cover" src={`${base}media/atlas-reconcile.jpg`} alt="Atlas OT Scout application during the recorded reconciliation workflow" loading="eager" fetchpriority="high" />
  </figure>

  <div class="mt-3 grid grid-cols-3 gap-3">
    <figure class="app-frame overflow-hidden bg-white">
      <img class="aspect-video w-full object-cover" src={`${base}media/atlas-collect.jpg`} alt="Atlas OT Scout recorded collection workflow" loading="lazy" />
      <figcaption class="border-t border-border px-3 py-2 text-xs font-semibold text-muted">Collect</figcaption>
    </figure>
    <figure class="app-frame overflow-hidden bg-white ring-2 ring-blue/25">
      <img class="aspect-video w-full object-cover" src={`${base}media/atlas-reconcile.jpg`} alt="Atlas OT Scout recorded reconciliation workflow" loading="lazy" />
      <figcaption class="border-t border-border bg-pale-blue px-3 py-2 text-xs font-semibold text-blue">Reconcile</figcaption>
    </figure>
    <figure class="app-frame overflow-hidden bg-white">
      <img class="aspect-video w-full object-cover" src={`${base}media/atlas-handoff.jpg`} alt="Atlas OT Scout recorded handoff workflow" loading="lazy" />
      <figcaption class="border-t border-border px-3 py-2 text-xs font-semibold text-muted">Handoff</figcaption>
    </figure>
  </div>

  <div class="mt-4 flex flex-wrap items-center justify-between gap-3 text-xs text-muted">
    <span>Actual emulator footage · generated by the repository demo workflow</span>
    <a class="font-semibold text-blue hover:text-navy" href={`${base}media/atlas-ot-scout-demo.mp4`}>Watch recorded workflow ↗</a>
  </div>
</div>
