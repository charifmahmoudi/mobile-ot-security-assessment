---
import type { Lang } from '../lib/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const fr = lang === 'fr';
const base = import.meta.env.BASE_URL;
---
<div class="relative">
  <figure class="app-frame app-shadow relative overflow-hidden bg-navy">
    <img class="block aspect-[16/10] w-full object-cover opacity-82" src={`${base}media/water-treatment-context.jpg`} alt={fr ? 'Contexte industriel illustratif de traitement de l’eau' : 'Illustrative water-treatment industrial context'} loading="eager" fetchpriority="high" />
    <div class="absolute inset-0 bg-gradient-to-tr from-navy/80 via-navy/18 to-transparent"></div>
    <figcaption class="absolute left-4 top-4 rounded-[8px] border border-aqua/25 bg-navy/88 px-3 py-2 text-[10px] font-bold uppercase tracking-[.10em] text-aqua backdrop-blur">{fr ? 'Contexte industriel illustratif' : 'Illustrative industrial context'}</figcaption>

    <div class="absolute bottom-4 right-4 w-[76%] overflow-hidden rounded-[11px] border border-white/40 bg-white shadow-[0_18px_46px_rgba(11,31,51,.34)] sm:bottom-6 sm:right-6 sm:w-[72%]">
      <div class="flex items-center justify-between border-b border-border bg-white px-3 py-2.5">
        <div class="flex items-center gap-2"><span class="size-2 rounded-full bg-blue"></span><span class="text-[11px] font-bold text-navy">Atlas OT Scout</span></div>
        <span class="text-[9px] font-bold uppercase tracking-[.09em] text-muted">{fr ? 'UI réelle · CI' : 'real UI · CI'}</span>
      </div>
      <img class="block aspect-video w-full object-cover" src={`${base}media/atlas-reconcile.jpg`} alt={fr ? 'Application Atlas pendant la réconciliation enregistrée' : 'Atlas application during recorded reconciliation'} loading="eager" />
    </div>
  </figure>

  <div class="mt-3 grid grid-cols-3 gap-3">
    {[
      ['atlas-collect.jpg', fr ? 'Collecter' : 'Collect'],
      ['atlas-reconcile.jpg', fr ? 'Réconcilier' : 'Reconcile'],
      ['atlas-handoff.jpg', 'Handoff'],
    ].map(([file,label], i) => (
      <figure class={`app-frame overflow-hidden bg-white ${i === 1 ? 'border-blue shadow-[0_0_0_1px_#2457d6]' : ''}`}>
        <img class="aspect-video w-full object-cover" src={`${base}media/${file}`} alt={`Atlas OT Scout · ${label}`} loading="lazy" />
        <figcaption class={`border-t border-border px-3 py-2 text-[11px] font-bold ${i === 1 ? 'text-blue' : 'text-muted'}`}>{label}</figcaption>
      </figure>
    ))}
  </div>

  <div class="mt-4 flex flex-wrap items-center justify-between gap-3 text-xs text-muted">
    <span>{fr ? 'Captures réelles de l’émulateur · aucune maquette produit' : 'Actual emulator captures · no product mockups'}</span>
    <a class="font-bold text-blue hover:text-navy" href={`${base}media/atlas-ot-scout-demo.mp4`}>{fr ? 'Voir le workflow enregistré' : 'Watch recorded workflow'} ↗</a>
  </div>
</div>
