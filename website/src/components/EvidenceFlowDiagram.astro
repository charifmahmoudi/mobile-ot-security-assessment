---
import type { Lang } from '../lib/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const fr = lang === 'fr';
const inputs = [
  [fr ? 'Inventaire attendu' : 'Expected inventory', fr ? 'baseline / registres client' : 'customer baseline / records', 'surface'],
  [fr ? 'Preuves hors ligne' : 'Offline evidence', 'PCAP / PCAPNG · ' + (fr ? 'aucune émission' : 'no transmission'), 'blue'],
  [fr ? 'Visibilité passive approuvée' : 'Approved passive visibility', 'SPAN / TAP · ' + (fr ? 'réception uniquement' : 'receive-only'), 'teal'],
  [fr ? 'Identité active exacte' : 'Exact active identity', fr ? 'une cible approuvée · une opération compilée' : 'one approved target · one compiled operation', 'blue'],
];
---
<figure class="app-frame overflow-hidden bg-white">
  <div class="border-b border-border bg-surface px-5 py-4">
    <p class="text-sm font-bold text-navy">{fr ? 'Flux de preuves borné' : 'Bounded evidence flow'}</p>
    <p class="mt-1 text-xs text-muted">{fr ? 'Utiliser la source adéquate la moins intrusive. Revoir avant d’accepter une conclusion.' : 'Use the least intrusive adequate source. Review before accepting conclusions.'}</p>
  </div>
  <div class="overflow-x-auto p-4 sm:p-6">
    <div class="grid min-w-[900px] grid-cols-[1fr_70px_1.15fr_70px_.9fr] items-center gap-y-3">
      <div class="pb-2 text-[11px] font-black uppercase tracking-[.12em] text-muted">{fr ? 'Entrées' : 'Inputs'}</div><div></div><div class="pb-2 text-[11px] font-black uppercase tracking-[.12em] text-muted">{fr ? 'Frontière de revue Atlas' : 'Atlas review boundary'}</div><div></div><div class="pb-2 text-[11px] font-black uppercase tracking-[.12em] text-muted">{fr ? 'Sortie' : 'Output'}</div>

      <div class="space-y-2">
        {inputs.map(([title,body,tone], i) => (
          <div class={`rounded-[10px] border p-4 ${tone === 'teal' ? 'border-success/35 bg-pale-teal' : tone === 'blue' ? 'border-blue/25 bg-pale-blue' : 'border-border bg-surface'}`}>
            <strong class="block text-sm text-navy">{title}</strong>
            <span class="mt-1 block text-xs text-muted">{body}</span>
            {i === 3 && <span class="mt-2 block text-[10px] font-black uppercase tracking-[.06em] text-blue">{fr ? 'Aucun balayage sous-réseau / ports / unit-ID' : 'No subnet / port / unit-ID sweep'}</span>}
          </div>
        ))}
      </div>

      <div class="grid place-items-center text-2xl font-black text-blue">→</div>

      <div class="rounded-[14px] bg-navy p-5 text-white shadow-[0_12px_30px_rgba(11,31,51,.18)]">
        <div class="rounded-[9px] bg-white p-4 text-navy"><span class="mr-2 text-success">●</span><strong class="text-sm">{fr ? 'Préserver source + provenance' : 'Preserve source + provenance'}</strong></div>
        <div class="grid h-8 place-items-center text-aqua">↓</div>
        <div class="rounded-[9px] bg-white p-4 text-navy"><span class="mr-2 text-blue">●</span><strong class="text-sm">{fr ? 'Revoir observations + identité' : 'Review observations + identity'}</strong></div>
        <div class="grid h-8 place-items-center text-aqua">↓</div>
        <div class="rounded-[9px] bg-pale-teal px-4 py-3 text-center text-[11px] font-black uppercase tracking-[.06em] text-success">{fr ? 'ACCEPTER · REJETER · NON RÉSOLU' : 'ACCEPT · REJECT · UNRESOLVED'}</div>
      </div>

      <div class="grid place-items-center text-2xl font-black text-success">→</div>

      <div class="space-y-3">
        <div class="rounded-[10px] border border-success/35 bg-pale-teal p-4"><strong class="block text-sm text-navy">{fr ? 'Baseline réconciliée' : 'Reconciled baseline'}</strong><span class="mt-1 block text-xs leading-5 text-muted">{fr ? 'corroboré · probable · conflit · inattendu · non observé' : 'corroborated · probable · conflict · unexpected · not observed'}</span></div>
        <div class="rounded-[10px] border border-border bg-surface p-4"><strong class="block text-sm text-navy">{fr ? 'Handoff revu' : 'Reviewed handoff'}</strong><span class="mt-1 block text-xs leading-5 text-muted">{fr ? 'preuves · constats · limites · vérification' : 'evidence · findings · limitations · verification'}</span></div>
      </div>

      <div></div><div></div>
      <div class="col-span-3 mt-3 rounded-[10px] border border-dashed border-danger/55 bg-white px-4 py-3 text-xs text-danger"><strong>{fr ? 'HORS DE CE CHEMIN PRODUIT :' : 'OUTSIDE THIS PRODUCT PATH:'}</strong> {fr ? 'balayage large · identifiants · exploitation · lecture/écriture de registres · contrôle' : 'broad scanning · credentials · exploitation · register reads/writes · control operations'}</div>
    </div>
  </div>
</figure>
