<figure class="app-frame overflow-hidden bg-white">
  <div class="border-b border-border bg-surface px-5 py-4">
    <p class="text-sm font-semibold text-text">Bounded evidence flow</p>
    <p class="mt-1 text-xs text-muted">Use the least intrusive adequate source. Review before accepting conclusions.</p>
  </div>
  <div class="overflow-x-auto p-4 sm:p-6">
    <svg class="mx-auto min-w-[820px]" viewBox="0 0 1060 410" role="img" aria-labelledby="flow-title flow-desc">
      <title id="flow-title">Atlas bounded evidence flow</title>
      <desc id="flow-desc">Expected inventory, offline packet captures, passive mirrored traffic, and one exact authorized identity request enter an evidence review boundary before reconciliation and final handoff. Broad scanning is outside the path.</desc>
      <defs>
        <marker id="flow-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8 z" fill="#2563EB" /></marker>
        <marker id="flow-aqua" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8 z" fill="#00ADB5" /></marker>
      </defs>
      <g font-family="system-ui, sans-serif">
        <text x="20" y="32" fill="#5B6572" font-size="13" font-weight="700" letter-spacing="1.4">INPUTS</text>
        <text x="402" y="32" fill="#5B6572" font-size="13" font-weight="700" letter-spacing="1.4">ATLAS REVIEW BOUNDARY</text>
        <text x="830" y="32" fill="#5B6572" font-size="13" font-weight="700" letter-spacing="1.4">OUTPUT</text>

        <rect x="20" y="60" width="250" height="60" rx="10" fill="#F6F8FB" stroke="#DAE0E7" /><text x="42" y="86" fill="#16191F" font-size="14" font-weight="700">Expected inventory</text><text x="42" y="106" fill="#5B6572" font-size="12">customer baseline / records</text>
        <rect x="20" y="140" width="250" height="60" rx="10" fill="#E9F0F7" stroke="#B8C7D8" /><text x="42" y="166" fill="#16191F" font-size="14" font-weight="700">Offline evidence</text><text x="42" y="186" fill="#5B6572" font-size="12">PCAP / PCAPNG · no transmission</text>
        <rect x="20" y="220" width="250" height="60" rx="10" fill="#E4F8F8" stroke="#00ADB5" /><text x="42" y="246" fill="#16191F" font-size="14" font-weight="700">Approved passive visibility</text><text x="42" y="266" fill="#5B6572" font-size="12">SPAN / TAP · receive-only path</text>
        <rect x="20" y="300" width="250" height="72" rx="10" fill="#EEF3FF" stroke="#2563EB" /><text x="42" y="326" fill="#16191F" font-size="14" font-weight="700">Exact authorized identity</text><text x="42" y="346" fill="#5B6572" font-size="12">one approved target · one compiled operation</text><text x="42" y="363" fill="#2563EB" font-size="11" font-weight="700">NO SUBNET / PORT / UNIT-ID SWEEP</text>

        <line x1="272" y1="90" x2="395" y2="150" stroke="#2563EB" stroke-width="2.5" marker-end="url(#flow-arrow)" />
        <line x1="272" y1="170" x2="395" y2="180" stroke="#2563EB" stroke-width="2.5" marker-end="url(#flow-arrow)" />
        <line x1="272" y1="250" x2="395" y2="210" stroke="#00ADB5" stroke-width="2.5" marker-end="url(#flow-aqua)" />
        <line x1="272" y1="336" x2="395" y2="240" stroke="#2563EB" stroke-width="2.5" marker-end="url(#flow-arrow)" />

        <rect x="405" y="88" width="310" height="206" rx="12" fill="#0B223A" />
        <rect x="430" y="112" width="260" height="48" rx="9" fill="#FFFFFF" /><circle cx="453" cy="136" r="6" fill="#00ADB5" /><text x="469" y="141" fill="#16191F" font-size="14" font-weight="700">Preserve source + provenance</text>
        <line x1="560" y1="161" x2="560" y2="179" stroke="#8FA3B7" stroke-width="2" marker-end="url(#flow-arrow)" />
        <rect x="430" y="181" width="260" height="48" rx="9" fill="#FFFFFF" /><circle cx="453" cy="205" r="6" fill="#2563EB" /><text x="469" y="210" fill="#16191F" font-size="14" font-weight="700">Review observations + identity</text>
        <line x1="560" y1="230" x2="560" y2="248" stroke="#8FA3B7" stroke-width="2" marker-end="url(#flow-arrow)" />
        <rect x="430" y="250" width="260" height="28" rx="9" fill="#E4F8F8" /><text x="560" y="269" text-anchor="middle" fill="#0B223A" font-size="12" font-weight="800">ACCEPT · REJECT · UNRESOLVED</text>

        <line x1="717" y1="191" x2="813" y2="191" stroke="#00ADB5" stroke-width="3" marker-end="url(#flow-aqua)" />
        <rect x="825" y="112" width="215" height="78" rx="10" fill="#E4F8F8" stroke="#00ADB5" /><text x="847" y="141" fill="#0B223A" font-size="15" font-weight="800">Reconciled baseline</text><text x="847" y="162" fill="#5B6572" font-size="12">confirmed · probable · conflict</text><text x="847" y="178" fill="#5B6572" font-size="12">unexpected · not observed</text>
        <rect x="825" y="210" width="215" height="78" rx="10" fill="#F6F8FB" stroke="#DAE0E7" /><text x="847" y="239" fill="#16191F" font-size="15" font-weight="800">Reviewed handoff</text><text x="847" y="260" fill="#5B6572" font-size="12">evidence · findings · limitations</text><text x="847" y="276" fill="#5B6572" font-size="12">audit + verification material</text>
        <line x1="932" y1="192" x2="932" y2="202" stroke="#2563EB" stroke-width="2" marker-end="url(#flow-arrow)" />

        <rect x="405" y="320" width="635" height="52" rx="10" fill="#FFF1F2" stroke="#BE2E38" stroke-dasharray="6 5" /><text x="427" y="351" fill="#7A1D24" font-size="13" font-weight="800">OUTSIDE THIS PRODUCT PATH:</text><text x="612" y="351" fill="#7A1D24" font-size="13">broad scanning · credentials · exploitation · register/control operations</text>
      </g>
    </svg>
  </div>
</figure>
