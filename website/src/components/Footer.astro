---
const base = import.meta.env.BASE_URL;
const repo = 'https://github.com/charifmahmoudi/mobile-ot-security-assessment';
---
<footer class="border-t border-white/10 bg-ink text-white">
  <div class="mx-auto grid max-w-7xl gap-8 px-5 py-10 sm:px-8 md:grid-cols-[1.4fr_1fr]">
    <div>
      <p class="text-lg font-semibold">Atlas OT Scout</p>
      <p class="mt-2 max-w-xl text-sm leading-6 text-white/55">A guided, offline OT evidence and assessment appliance for authorized water and wastewater work.</p>
    </div>
    <div class="flex flex-wrap gap-x-6 gap-y-3 text-sm text-white/65 md:justify-end">
      <a class="hover:text-white" href={`${base}safety/`}>Safety &amp; Trust</a>
      <a class="hover:text-white" href={`${base}pilot/`}>Pilot</a>
      <a class="hover:text-white" href={`${repo}/wiki`}>Wiki</a>
      <a class="hover:text-white" href={`${repo}/blob/main/IMPLEMENTATION.md`}>Implementation</a>
      <a class="hover:text-white" href={repo}>GitHub</a>
    </div>
  </div>
  <div class="border-t border-white/10 px-5 py-5 text-center text-xs text-white/40">Research prototype · Current capability claims are maintained in IMPLEMENTATION.md.</div>
</footer>
