---
import SiteLayout from '../../layouts/SiteLayout.astro';
import EvidenceFlowDiagram from '../EvidenceFlowDiagram.astro';
import { bookingUrl, repo, type Lang } from '../../lib/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const fr = lang === 'fr';
const base = import.meta.env.BASE_URL;

const copy = fr ? {
  title: 'Sécurité & maîtrise — Atlas OT Scout',
  description: "Atlas privilégie les preuves passives, borne les opérations actives et conserve une frontière explicite entre observation et conclusion acceptée.",
  label: 'Sécurité & maîtrise',
  h1: "Une chaîne de preuve n'est défendable que si la collecte l'est aussi.",
  intro: "Atlas sépare les preuves importées et passives des opérations actives explicitement autorisées, puis impose une revue avant toute conclusion d'inventaire.",
  rules: [
    ['Autorisation avant émission','Toute opération produisant des paquets doit rester dans le périmètre, la cible et la fenêtre approuvés.'],
    ['Passif par défaut','Les captures existantes ou la visibilité SPAN/TAP sont privilégiées lorsqu’elles suffisent à répondre à la question.'],
    ['Actif exact et borné','Le chemin initial autorise une identification Modbus/TCP sur une cible précise — pas un balayage de sous-réseau, de ports ou d’unités.'],
    ['Observation ≠ vérité d’inventaire','Les preuves brutes, les affirmations d’identité et les décisions acceptées restent distinctes.'],
    ['Limites explicites','Une absence d’observation, une visibilité insuffisante ou un conflit non résolu restent visibles dans le résultat.'],
    ['Fonctionnement hors ligne','La collecte, la réconciliation et le handoff ne dépendent pas d’un service cloud.'],
  ],
  technical: 'Revue technique',
  technicalTitle: 'Les contrats exacts sont publics.',
  technicalBody: "Le site résume l'approche. Les reviewers peuvent inspecter directement l'état d'implémentation, le contrat réseau, le modèle de menace et les preuves de test.",
  cta: 'Challenger le modèle de sécurité',
} : {
  title: 'Safety & Control — Atlas OT Scout',
  description: 'Atlas prefers passive evidence, bounds active operations, and keeps observation separate from accepted inventory conclusions.',
  label: 'Safety & control',
  h1: 'An evidence chain is defensible only when its collection is too.',
  intro: 'Atlas separates imported and passive evidence from explicitly authorized active operations, then requires review before inventory conclusions are accepted.',
  rules: [
    ['Authorization before transmission','Any packet-producing operation must stay inside the approved scope, target and window.'],
    ['Passive by default','Existing captures or SPAN/TAP visibility are preferred when they can answer the question.'],
    ['Exact bounded active work','The initial path permits Modbus/TCP identification against one exact target—not subnet, port or unit-ID sweeps.'],
    ['Observation ≠ inventory truth','Raw evidence, identity claims and accepted decisions remain separate.'],
    ['Explicit limitations','Not observed, insufficient visibility and unresolved conflicts remain visible in the result.'],
    ['Offline workflow','Collection, reconciliation and handoff do not depend on a cloud service.'],
  ],
  technical: 'Technical review',
  technicalTitle: 'The exact contracts are public.',
  technicalBody: 'The site summarizes the approach. Reviewers can inspect implementation status, the network contract, the threat model and test evidence directly.',
  cta: 'Challenge the security model',
};
---
<SiteLayout title={copy.title} description={copy.description} lang={lang} page="safety">
  <section class="relative overflow-hidden bg-navy text-white">
    <div class="blueprint-grid absolute inset-0 opacity-55"></div>
    <div class="relative mx-auto grid max-w-7xl gap-10 px-5 py-16 sm:px-8 lg:grid-cols-[.78fr_1.22fr] lg:items-center lg:py-20">
      <div>
        <p class="text-xs font-black uppercase tracking-[.16em] text-aqua">{copy.label}</p>
        <h1 class="mt-5 text-5xl font-black leading-[1.04] tracking-[-0.045em] sm:text-6xl">{copy.h1}</h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-white/66">{copy.intro}</p>
        <a class="mt-8 inline-block rounded-[11px] bg-blue px-5 py-3 text-sm font-bold text-white transition hover:bg-white hover:text-navy" href={bookingUrl} target="_blank" rel="noreferrer">{copy.cta}</a>
      </div>
      <figure class="app-frame app-shadow overflow-hidden border-white/15 bg-white">
        <img class="block aspect-video w-full object-cover" src={`${base}media/atlas-collect.jpg`} alt={fr ? 'Application Atlas OT Scout pendant le workflow de collecte enregistré' : 'Atlas OT Scout application during the recorded collection workflow'} />
        <figcaption class="flex items-center justify-between border-t border-border bg-surface px-4 py-3 text-xs text-muted"><span>{fr ? 'Sortie réelle de l’émulateur' : 'Actual emulator output'}</span><span class="font-bold text-blue">{fr ? 'Collecte → revue' : 'Collect → review'}</span></figcaption>
      </figure>
    </div>
  </section>

  <section class="bg-surface">
    <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8">
      <div class="grid gap-px overflow-hidden rounded-[14px] border border-border bg-border md:grid-cols-2 lg:grid-cols-3">
        {copy.rules.map(([title,body], i) => (
          <article class="bg-white p-6 sm:p-7">
            <span class="grid size-8 place-items-center rounded-full bg-pale-blue text-xs font-black text-blue">0{i + 1}</span>
            <h2 class="mt-6 text-xl font-bold text-navy">{title}</h2>
            <p class="mt-3 leading-7 text-muted">{body}</p>
          </article>
        ))}
      </div>
      <div class="mt-8"><EvidenceFlowDiagram lang={lang} /></div>
    </div>
  </section>

  <section class="border-y border-border bg-white">
    <div class="mx-auto grid max-w-7xl gap-10 px-5 py-20 sm:px-8 lg:grid-cols-[.75fr_1.25fr]">
      <div>
        <p class="section-label">{copy.technical}</p>
        <h2 class="mt-3 text-4xl font-black tracking-[-0.035em] text-navy">{copy.technicalTitle}</h2>
        <p class="mt-5 leading-7 text-muted">{copy.technicalBody}</p>
        <a class="mt-6 inline-block text-sm font-bold text-blue hover:text-navy" href={bookingUrl} target="_blank" rel="noreferrer">{copy.cta} →</a>
      </div>
      <div class="app-frame overflow-hidden bg-white">
        {[
          [fr ? 'Implémentation actuelle' : 'Implementation status', `${repo}/blob/main/IMPLEMENTATION.md`, fr ? 'Ce qui s’exécute aujourd’hui et ce qui reste différé.' : 'What executes today and what remains deferred.'],
          [fr ? 'Exécution réseau' : 'Network execution', `${repo}/blob/main/docs/architecture/NETWORK-EXECUTION.md`, fr ? 'Comportement actif/passif exact et conditions d’arrêt.' : 'Exact active/passive behavior and stop boundaries.'],
          [fr ? 'Modèle de sécurité' : 'Security model', `${repo}/blob/main/docs/architecture/SECURITY-AND-THREAT-MODEL.md`, fr ? 'Menaces, contrôles et risques résiduels.' : 'Threats, controls and residual risks.'],
          [fr ? 'Preuves de test' : 'Verification evidence', `${repo}/tree/main/docs/testing`, fr ? 'CI, testbeds et limites de preuve.' : 'CI, testbeds and proof boundaries.'],
        ].map(([title,href,body], i) => <a class={`grid gap-1 px-5 py-4 transition hover:bg-pale-blue ${i < 3 ? 'border-b border-border' : ''}`} href={href}><strong class="text-sm text-navy">{title} ↗</strong><span class="text-sm leading-6 text-muted">{body}</span></a>)}
      </div>
    </div>
  </section>
</SiteLayout>
