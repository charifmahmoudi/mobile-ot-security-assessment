---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { bookingUrl, repo, sitePath, wiki, type Lang } from '../../lib/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const fr = lang === 'fr';
const base = import.meta.env.BASE_URL;
const evaluation = sitePath(base, lang, 'pilot');

const copy = fr ? {
  title: 'Atlas OT Scout — projet open source d’évaluation OT terrain',
  description: "Atlas OT Scout est un prototype open source d’évaluation OT terrain pour l’eau et l’assainissement, exécuté hors ligne sur un appareil Android dédié.",
  kicker: 'Prototype open source · Eau et assainissement',
  h1: 'Atlas OT Scout',
  definition: "Atlas OT Scout est un prototype d'évaluation ciblée de l'inventaire et de l'exposition réseau OT sur le terrain.",
  intro: "Atlas vous aide, dans un périmètre défini et sous l'autorité de l'exploitant, à vérifier quels actifs sont présents et quelles preuves soutiennent leur identité. L'objectif : découvrir les écarts avant l'arrêt, lorsqu'il est encore possible d'adapter l'intervention. L'application Android dédiée fonctionne hors ligne.",
  primary: "Évaluer l'adéquation d'Atlas",
  secondary: 'Voir le cas terrain',
  facts: [['Question', 'Quels actifs OT sont réellement concernés ?'], ['Sources', 'Inventaire · PCAP/PCAPNG · relevé terrain'], ['Décision', "Poursuivre · adapter · reporter avant l'arrêt"]],
  projectLabel: 'Le projet',
  projectTitle: "Préparer l'intervention, pas seulement corriger l'inventaire.",
  projectBody: "Atlas organise une évaluation sur un segment eau ou assainissement défini. Le but est de donner au responsable maintenance assez d'éléments pour confirmer la cible, préparer la procédure, les pièces et les compétences requises — ou reporter l'action avant d'immobiliser la pompe. Le périmètre P0 actuel couvre l'analyse passive de captures réseau et une identification Modbus/TCP strictement ciblée lorsqu'elle est autorisée.",
  projectQuestions: [['Présence', 'Les actifs attendus ont-ils été observés dans le périmètre ?'], ['Identité', 'Quelles sources soutiennent le fournisseur, le produit et la révision ?'], ['Écart', 'Quelles contradictions doivent être résolues avant la maintenance ?']],
  caseTag: 'Cas d’usage illustratif · Pompe P-04',
  caseTitle: 'La maintenance commence demain.',
  caseMeta: ['Cible documentée 10.20.4.18', 'Modbus/TCP observé', 'Fenêtre 07:00–08:15'],
  caseIntro: "L'inventaire, le schéma et le trafic disponible ne s'accordent pas sur la révision du contrôleur. Atlas rend cet écart visible la veille : le responsable peut confirmer la cible, adapter les moyens prévus ou reporter l'action avant d'immobiliser la pompe.",
  workflowLabel: 'Workflow inspectable',
  workflowTitle: "Ce qu'Atlas fait, étape par étape",
  workflowIntro: "Chaque source reste identifiable. Le niveau de preuve et la décision de revue sont enregistrés avec la conclusion.",
  steps: [
    { num: '01', time: '16:42', title: 'Borner le cas et l’autorité', body: "L'équipe enregistre l'actif, la cible exacte, la fenêtre, les exclusions, les méthodes permises et les conditions d'arrêt. Sans ce contexte, aucune action réseau active n'est admise.", result: 'Cas C-2026-041 · une cible · autorité locale' },
    { num: '02', time: '07:15', title: 'Exploiter la preuve passive', body: "Atlas importe hors ligne la fiche attendue et une capture PCAP/PCAPNG autorisée. Le trafic vers TCP/502 confirme un service Modbus/TCP ; il ne confirme pas à lui seul le modèle ou la révision.", result: 'E3 déclaré + E4 trafic passif · identité non confirmée' },
    { num: '03', time: '07:32', title: 'Résoudre un écart précis, si autorisé', body: "Si l'écart justifie une preuve plus forte, Atlas peut exécuter une seule opération compilée vers la cible signée : Read Device Identification, fonction 0x2B / MEI 0x0E, objets de base uniquement.", result: 'E2 protocolaire · fournisseur, code produit, révision' },
    { num: '04', time: '08:05', title: 'Faire revoir la conclusion', body: "L'évaluateur rapproche la déclaration, le trafic, l'identité protocolaire et la plaque physique. Le conflit reste visible jusqu'à une décision humaine ; l'export contient aussi les limites et les empreintes des sources.", result: 'Conclusion revue · exception conservée · export hors ligne' },
  ],
  passiveTitle: 'D’abord : aucune émission réseau',
  passiveBody: "L'appareil analyse localement les sources déjà autorisées. Une adresse IP, un port ou un OUI reste un indice de contexte, jamais une identité inventée.",
  activeLabel: 'Profil actif P0 exact',
  activeTitle: 'Une opération. Une cible. Aucun élargissement.',
  activeRows: [['Cible', '10.20.4.18 : 502 · Unit ID approuvé'], ['Requête', '0x2B · MEI 0x0E · Basic · Object 0x00'], ['Réponse bornée', 'Objets 0x00–0x02 · maximum 512 octets'], ['Arrêt', 'Expiration · détachement · demande opérateur']],
  never: ['Pas de balayage de sous-réseau, de ports ou d’Unit ID', 'Pas de lecture ni écriture de registres', 'Pas de credentials, fuzzing, exploit ou socket arbitraire', 'Pas de repli vers une méthode plus large en cas d’échec'],
  evidenceModelLabel: 'Modèle de preuve',
  evidenceModelTitle: "Observer un service ne suffit pas à identifier un actif.",
  evidenceModelBody: "Atlas conserve séparément la déclaration, l'observation réseau, la réponse protocolaire et le relevé physique. Une conclusion n'est créée qu'après rapprochement et revue. Si la fonction d'identification n'est pas supportée, le résultat reste une preuve de service Modbus/TCP.",
  ledgerLabel: 'Dossier de preuve · 07:48',
  ledgerTitle: 'Les couches restent séparées jusqu’à la revue',
  ledgerRows: [['E3 · Déclaré', 'PLC-PUMP-04 · M580 NOC · révision 3', 'À vérifier'], ['E4 · Passif', '10.20.4.18 · TCP/502 · Modbus/TCP', 'Observé'], ['E2 · Protocole', 'Fournisseur + code produit + révision', 'Collecté'], ['E1 · Physique', 'Plaque / numéro de série sur site', 'Référence forte'], ['Revue', 'Révision différente de la fiche attendue', 'Conflit ouvert']],
  outputLabel: 'Livrable opérationnel',
  outputTitle: "Le livrable : une décision avant l'arrêt",
  outputs: [['Périmètre et autorité', 'Fenêtre, cibles, exclusions, méthodes admises et conditions d’arrêt.'], ['Registre de preuve', 'Chaque observation avec source, horodatage, niveau E1–E6 et empreinte.'], ['Décision de revue', 'Correspondance acceptée, rejetée ou laissée non résolue avec justification.'], ['Paquet exportable', 'Dossier hors ligne pour le handoff, sans dépendre d’un cloud au moment critique.']],
  boundariesTitle: 'Ce qu’Atlas est — et ce qu’il n’est pas',
  doesLabel: 'Atlas permet',
  does: ['Inventaire OT ciblé et rapprochement de preuves', 'Analyse PCAP et PCAPNG hors ligne', 'Identification Modbus/TCP bornée lorsqu’elle est autorisée', 'Provenance, confiance, conflits et décisions de revue'],
  doesNotLabel: 'Atlas ne prétend pas',
  doesNot: ['Découvrir tous les actifs ou prouver l’absence des non-observés', 'Scanner un réseau ou tester l’exploitabilité', 'Certifier la conformité ou la couverture complète', 'Remplacer l’autorité opérateur et le jugement professionnel'],
  openLabel: 'Ingénierie inspectable',
  openTitle: 'Le comportement réseau exact est public.',
  openBody: "Le dépôt publie l'implémentation actuelle, le contrat d'exécution réseau, la méthode de preuve, le modèle de menace et les tests.",
  ctaLabel: 'Évaluation méthodologique',
  ctaTitle: 'Atlas convient-il à votre prochain arrêt de maintenance ?',
  ctaBody: "Apportez un cas anonymisé : actif attendu, preuve disponible, fenêtre d'intervention et autorité. La revue déterminera si le workflow Atlas peut répondre à votre question dans ce périmètre.",
  ctaSecondary: "Lire le cadre d'évaluation",
} : {
  title: 'Atlas OT Scout — open-source field OT assessment project',
  description: 'Atlas OT Scout is an open-source field OT assessment prototype for water and wastewater, running offline on a dedicated Android appliance.',
  kicker: 'Open-source prototype · Water and wastewater',
  h1: 'Atlas OT Scout',
  definition: 'Atlas OT Scout is a prototype for targeted field assessment of OT inventory and network exposure.',
  intro: 'Atlas helps you, within a defined scope and under operator authority, determine which assets are present and what evidence supports their identity. The purpose: find discrepancies before shutdown, while there is still time to adapt the intervention. The dedicated Android application works offline.',
  primary: 'Assess Atlas fit',
  secondary: 'See the field case',
  facts: [['Question', 'Which OT assets are actually in scope?'], ['Sources', 'Inventory · PCAP/PCAPNG · field record'], ['Decision', 'Proceed · adapt · postpone before shutdown']],
  projectLabel: 'The project',
  projectTitle: 'Prepare the intervention—not just correct the inventory.',
  projectBody: 'Atlas structures an assessment on one defined water or wastewater segment. Its purpose is to give the maintenance owner enough evidence to confirm the target, prepare the procedure, parts, and required expertise—or postpone the action before taking the pump out of service. The current P0 covers passive packet-capture analysis and one strictly targeted Modbus/TCP identity operation when authorized.',
  projectQuestions: [['Presence', 'Were the expected assets observed inside the assessment scope?'], ['Identity', 'Which sources support the vendor, product, and revision?'], ['Discrepancy', 'Which contradictions must be resolved before maintenance?']],
  caseTag: 'Illustrative use case · Pump P-04',
  caseTitle: 'Maintenance starts tomorrow.',
  caseMeta: ['Documented target 10.20.4.18', 'Modbus/TCP observed', 'Window 07:00–08:15'],
  caseIntro: 'The inventory, drawing, and available traffic disagree on the controller revision. Atlas makes that discrepancy visible the day before: the owner can confirm the target, adapt the planned resources, or postpone the action before taking the pump out of service.',
  workflowLabel: 'Inspectable workflow',
  workflowTitle: 'What Atlas does, step by step',
  workflowIntro: 'Each source remains identifiable. Evidence strength and the review decision are recorded with the conclusion.',
  steps: [
    { num: '01', time: '16:42', title: 'Bound the case and authority', body: 'The team records the asset, exact target, operating window, exclusions, permitted methods, and stop conditions. Without that context, no active network action is admitted.', result: 'Case C-2026-041 · one target · local authority' },
    { num: '02', time: '07:15', title: 'Use passive evidence first', body: 'Atlas imports the expected record and an authorized PCAP/PCAPNG capture offline. Traffic to TCP/502 confirms a Modbus/TCP service; by itself, it does not confirm the model or revision.', result: 'E3 declared + E4 passive traffic · identity unconfirmed' },
    { num: '03', time: '07:32', title: 'Resolve one gap, if authorized', body: 'When the gap justifies stronger evidence, Atlas can execute one compiled operation to the signed target: Read Device Identification, function 0x2B / MEI 0x0E, basic objects only.', result: 'E2 protocol evidence · vendor, product code, revision' },
    { num: '04', time: '08:05', title: 'Review the conclusion', body: 'The assessor reconciles the declaration, traffic, protocol identity, and physical label. A conflict remains visible until a human decision; the export includes limitations and source hashes.', result: 'Reviewed conclusion · exception retained · offline export' },
  ],
  passiveTitle: 'First: no network emission',
  passiveBody: 'The appliance analyzes already-authorized sources locally. An IP address, open port, or OUI stays a contextual clue—never invented identity.',
  activeLabel: 'Exact P0 active profile',
  activeTitle: 'One operation. One target. No expansion.',
  activeRows: [['Target', '10.20.4.18 : 502 · approved Unit ID'], ['Request', '0x2B · MEI 0x0E · Basic · Object 0x00'], ['Bounded response', 'Objects 0x00–0x02 · 512 bytes maximum'], ['Stop', 'Expiry · detach · operator request']],
  never: ['No subnet, port, or Unit ID sweep', 'No process-register read or write', 'No credentials, fuzzing, exploitation, or arbitrary socket', 'No fallback to a broader method after failure'],
  evidenceModelLabel: 'Evidence model',
  evidenceModelTitle: 'Observing a service is not enough to identify an asset.',
  evidenceModelBody: 'Atlas keeps the declaration, network observation, protocol response, and physical record separate. A conclusion is created only after reconciliation and review. If device identification is unsupported, the result remains Modbus/TCP service evidence.',
  ledgerLabel: 'Evidence case · 07:48',
  ledgerTitle: 'Layers stay separate until review',
  ledgerRows: [['E3 · Declared', 'PLC-PUMP-04 · M580 NOC · revision 3', 'Verify'], ['E4 · Passive', '10.20.4.18 · TCP/502 · Modbus/TCP', 'Observed'], ['E2 · Protocol', 'Vendor + product code + revision', 'Collected'], ['E1 · Physical', 'Site label / serial number', 'Strong reference'], ['Review', 'Revision differs from expected record', 'Conflict open']],
  outputLabel: 'Operational deliverable',
  outputTitle: 'The deliverable: a decision before shutdown',
  outputs: [['Scope and authority', 'Window, targets, exclusions, admitted methods, and stop conditions.'], ['Evidence register', 'Every observation with source, time, E1–E6 strength, and hash.'], ['Review decision', 'Match accepted, rejected, or left unresolved with rationale.'], ['Exportable package', 'Offline handoff package without a cloud dependency at the critical moment.']],
  boundariesTitle: 'What Atlas is—and what it is not',
  doesLabel: 'Atlas provides',
  does: ['Targeted OT inventory and evidence reconciliation', 'Offline PCAP and PCAPNG analysis', 'Bounded Modbus/TCP identity when authorized', 'Provenance, confidence, conflicts, and review decisions'],
  doesNotLabel: 'Atlas does not claim',
  doesNot: ['Discover every asset or prove unobserved assets are absent', 'Scan a network or test exploitability', 'Certify compliance or complete coverage', 'Replace operator authority or professional judgment'],
  openLabel: 'Inspectable engineering',
  openTitle: 'The exact network behavior is public.',
  openBody: 'The repository publishes the current implementation, network-execution contract, evidence method, threat model, and tests.',
  ctaLabel: 'Methodology fit review',
  ctaTitle: 'Does Atlas fit your next maintenance outage?',
  ctaBody: 'Bring an anonymized case: expected asset, available evidence, maintenance window, and authority. The review will determine whether the Atlas workflow can answer your question within that scope.',
  ctaSecondary: 'Read the evaluation framework',
};

const hero = `${base}media/atlas-field-case-hero.webp`;
const evidenceImage = `${base}media/atlas-field-case-evidence.webp`;
const handoffImage = `${base}media/atlas-field-case-handoff.webp`;
---
<SiteLayout title={copy.title} description={copy.description} lang={lang} page="home">
  <section id="project" class="blueprint-grid-light scroll-mt-24 border-b border-border bg-paper">
    <div class="mx-auto grid min-h-[660px] max-w-7xl gap-10 px-5 pb-14 pt-16 sm:px-8 lg:grid-cols-[.88fr_1.12fr] lg:items-center lg:py-20">
      <div>
        <p class="case-kicker text-blue">{copy.kicker}</p>
        <h1 class="mt-5 max-w-3xl text-5xl font-black leading-[.96] tracking-[-.05em] text-navy sm:text-7xl lg:text-[5.35rem]">{copy.h1}</h1>
        <p class="mt-7 max-w-2xl text-2xl font-bold leading-9 text-navy">{copy.definition}</p>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-muted">{copy.intro}</p>
        <div class="mt-8 flex flex-wrap gap-3"><a class="case-button case-button-primary" href={bookingUrl} target="_blank" rel="noreferrer">{copy.primary}</a><a class="case-button border border-border bg-white text-navy hover:border-blue hover:text-blue" href="#case">{copy.secondary} ↓</a></div>
      </div>
      <figure class="technical-figure"><img src={hero} alt={fr ? "Responsable eau avec un appareil Atlas devant un module Ethernet M580 dans une armoire fermée" : "Water operations lead with an Atlas appliance beside an M580 Ethernet module in a closed cabinet"} width="1672" height="941" fetchpriority="high" /><figcaption><span>01</span><p>{copy.caseTag}</p></figcaption></figure>
    </div>
    <div class="border-t border-border bg-white/80"><dl class="mx-auto grid max-w-7xl divide-y divide-border px-5 sm:px-8 md:grid-cols-3 md:divide-x md:divide-y-0">{copy.facts.map(([term, value]) => <div class="py-5 md:px-7 first:pl-0"><dt class="font-mono text-xs font-bold uppercase tracking-[.12em] text-blue">{term}</dt><dd class="mt-2 font-bold text-navy">{value}</dd></div>)}</dl></div>
  </section>

  <section class="border-b border-border bg-white">
    <div class="mx-auto grid max-w-7xl gap-10 px-5 py-16 sm:px-8 lg:grid-cols-[.8fr_1.2fr] lg:py-24">
      <div>
        <p class="section-label">{copy.projectLabel}</p>
        <h2 class="mt-3 text-4xl font-black tracking-[-.04em] text-navy sm:text-5xl">{copy.projectTitle}</h2>
        <p class="mt-6 text-lg leading-8 text-muted">{copy.projectBody}</p>
      </div>
      <div class="grid gap-px overflow-hidden rounded-xl border border-border bg-border sm:grid-cols-3 lg:self-end">
        {copy.projectQuestions.map(([title, body], i) => <article class="bg-surface p-5"><span class="font-mono text-xs font-black text-blue">0{i + 1}</span><h3 class="mt-5 text-lg font-black text-navy">{title}</h3><p class="mt-3 text-sm leading-6 text-muted">{body}</p></article>)}
      </div>
    </div>
  </section>

  <section id="case" class="scroll-mt-24 border-b border-border bg-white"><div class="mx-auto grid max-w-7xl gap-9 px-5 py-16 sm:px-8 lg:grid-cols-[.78fr_1.22fr] lg:py-24"><div><p class="section-label">{copy.caseTag}</p><h2 class="mt-3 text-4xl font-black tracking-[-.04em] text-navy">{copy.caseTitle}</h2></div><div><p class="max-w-3xl text-xl font-semibold leading-8 text-navy">{copy.caseIntro}</p><ul class="mt-7 flex flex-wrap gap-2">{copy.caseMeta.map(item => <li class="rounded-full border border-border bg-surface px-3 py-2 font-mono text-xs font-bold text-slate">{item}</li>)}</ul></div></div></section>

  <section id="workflow" class="scroll-mt-24 bg-paper"><div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:py-28"><p class="section-label">{copy.workflowLabel}</p><div class="mt-3 grid gap-6 lg:grid-cols-[1.2fr_.8fr] lg:items-end"><h2 class="text-4xl font-black tracking-[-.045em] text-navy sm:text-6xl">{copy.workflowTitle}</h2><p class="text-lg leading-8 text-muted">{copy.workflowIntro}</p></div><div class="mt-12 border-y border-border">{copy.steps.map((step, i) => <article class={`workflow-row grid gap-5 py-8 lg:grid-cols-[.18fr_.55fr_1.4fr_1fr] lg:items-start ${i < copy.steps.length - 1 ? 'border-b border-border' : ''}`}><span class="font-mono text-3xl font-black text-blue">{step.num}</span><time class="pt-1 font-mono text-sm font-bold text-muted">{step.time}</time><div><h3 class="text-2xl font-black tracking-[-.025em] text-navy">{step.title}</h3><p class="mt-3 leading-7 text-muted">{step.body}</p></div><p class="workflow-result">{step.result}</p></article>)}</div></div></section>

  <section class="border-y border-aqua/15 bg-navy text-white"><div class="mx-auto grid max-w-7xl gap-12 px-5 py-20 sm:px-8 lg:grid-cols-[.92fr_1.08fr] lg:items-center lg:py-28"><div><p class="case-eyebrow text-aqua">{copy.activeLabel}</p><h2 class="mt-3 text-4xl font-black tracking-[-.04em] sm:text-5xl">{copy.activeTitle}</h2><div class="mt-8 overflow-hidden rounded-xl border border-white/15 bg-white/[.045]"><dl>{copy.activeRows.map(([term, value], i) => <div class={`grid gap-2 px-5 py-4 sm:grid-cols-[.42fr_1fr] ${i < copy.activeRows.length - 1 ? 'border-b border-white/10' : ''}`}><dt class="text-sm font-bold text-aqua">{term}</dt><dd class="font-mono text-sm text-white/85">{value}</dd></div>)}</dl></div><ul class="mt-7 grid gap-3">{copy.never.map(item => <li class="boundary-dark">{item}</li>)}</ul></div><div><figure class="technical-figure technical-figure-dark"><img src={evidenceImage} alt={fr ? "Module Ethernet M580 relié à un chemin de capture approuvé et à un appareil Atlas" : "M580 Ethernet module connected through an approved capture path to an Atlas appliance"} width="1672" height="941" loading="lazy" decoding="async" /></figure><div class="mt-5 border-l-2 border-aqua/70 pl-5"><h3 class="font-bold text-white">{copy.passiveTitle}</h3><p class="mt-2 text-sm leading-6 text-white/62">{copy.passiveBody}</p></div></div></div></section>

  <section class="border-b border-border bg-white"><div class="mx-auto grid max-w-7xl gap-10 px-5 py-20 sm:px-8 lg:grid-cols-[.78fr_1.22fr] lg:items-start lg:py-24"><div><p class="section-label">{copy.evidenceModelLabel}</p><h2 class="mt-3 text-3xl font-black tracking-[-.035em] text-navy">{copy.evidenceModelTitle}</h2><p class="mt-5 leading-7 text-muted">{copy.evidenceModelBody}</p></div><div class="evidence-ledger-light"><div class="border-b border-border px-5 py-5"><p class="font-mono text-xs font-bold uppercase tracking-[.12em] text-blue">{copy.ledgerLabel}</p><h3 class="mt-2 text-xl font-black text-navy">{copy.ledgerTitle}</h3></div><dl>{copy.ledgerRows.map(([term, value, state], i) => <div class={`grid gap-2 px-5 py-4 sm:grid-cols-[.62fr_1.35fr_.7fr] ${i < copy.ledgerRows.length - 1 ? 'border-b border-border' : ''}`}><dt class="text-sm font-bold text-muted">{term}</dt><dd class="font-mono text-sm text-navy">{value}</dd><dd class={`text-sm font-bold sm:text-right ${i === copy.ledgerRows.length - 1 ? 'text-amber' : 'text-teal'}`}>{state}</dd></div>)}</dl></div></div></section>

  <section id="deliverable" class="scroll-mt-24 bg-surface"><div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:py-28"><div class="grid gap-10 lg:grid-cols-[.95fr_1.05fr] lg:items-center"><div><p class="section-label">{copy.outputLabel}</p><h2 class="mt-3 text-4xl font-black tracking-[-.04em] text-navy sm:text-5xl">{copy.outputTitle}</h2><div class="mt-9 grid gap-5 sm:grid-cols-2">{copy.outputs.map(([title, body], i) => <article class="deliverable-card"><span>0{i + 1}</span><h3>{title}</h3><p>{body}</p></article>)}</div></div><figure class="technical-figure"><img src={handoffImage} alt={fr ? "Responsable et technicien examinant le dossier de preuve Atlas avant maintenance" : "Operations lead and technician reviewing the Atlas evidence case before maintenance"} width="1672" height="941" loading="lazy" decoding="async" /></figure></div></div></section>

  <section id="boundaries" class="scroll-mt-24 border-y border-border bg-white"><div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:py-24"><h2 class="max-w-4xl text-4xl font-black tracking-[-.04em] text-navy sm:text-5xl">{copy.boundariesTitle}</h2><div class="mt-10 grid overflow-hidden rounded-xl border border-border lg:grid-cols-2"><div class="p-7 lg:p-9"><p class="case-eyebrow text-teal">{copy.doesLabel}</p><ul class="mt-6 space-y-4">{copy.does.map(item => <li class="boundary-item boundary-item-yes">{item}</li>)}</ul></div><div class="border-t border-border bg-surface p-7 lg:border-l lg:border-t-0 lg:p-9"><p class="case-eyebrow text-amber">{copy.doesNotLabel}</p><ul class="mt-6 space-y-4">{copy.doesNot.map(item => <li class="boundary-item boundary-item-no">{item}</li>)}</ul></div></div></div></section>

  <section class="bg-navy text-white"><div class="mx-auto grid max-w-7xl gap-10 px-5 py-16 sm:px-8 lg:grid-cols-[.8fr_1.2fr] lg:items-center"><div><p class="case-eyebrow text-aqua">{copy.openLabel}</p><h2 class="mt-3 text-4xl font-black tracking-[-.04em]">{copy.openTitle}</h2><p class="mt-5 text-lg leading-8 text-white/65">{copy.openBody}</p></div><div class="overflow-hidden rounded-xl border border-white/12 bg-white/[.045]">{[[fr ? 'Guide opérateur et évaluation' : 'Operator and evaluation guide', wiki],[fr ? 'Implémentation actuelle' : 'Current implementation', `${repo}/blob/main/IMPLEMENTATION.md`],[fr ? 'Exécution réseau exacte' : 'Exact network execution', `${repo}/blob/main/docs/architecture/NETWORK-EXECUTION.md`],[fr ? 'Méthode de preuve' : 'Evidence method', `${repo}/blob/main/docs/poc/ASSESSMENT-METHOD.md`],[fr ? 'Modèle de menace' : 'Threat model', `${repo}/blob/main/docs/architecture/SECURITY-AND-THREAT-MODEL.md`]].map(([label, href], i) => <a class={`flex items-center justify-between px-5 py-4 text-sm font-bold transition hover:bg-white/[.07] hover:text-aqua ${i < 4 ? 'border-b border-white/10' : ''}`} href={href}><span>{label}</span><span aria-hidden="true">↗</span></a>)}</div></div></section>

  <section class="bg-blue text-white"><div class="mx-auto max-w-5xl px-5 py-20 text-center sm:px-8 lg:py-28"><p class="case-eyebrow text-white/65">{copy.ctaLabel}</p><h2 class="mt-4 text-4xl font-black tracking-[-.045em] sm:text-6xl">{copy.ctaTitle}</h2><p class="mx-auto mt-6 max-w-3xl text-lg leading-8 text-white/78">{copy.ctaBody}</p><div class="mt-8 flex flex-wrap justify-center gap-3"><a class="case-button bg-white text-navy hover:bg-aqua" href={bookingUrl} target="_blank" rel="noreferrer">{copy.primary} →</a><a class="case-button border border-white/30 text-white hover:bg-white/10" href={evaluation}>{copy.ctaSecondary}</a></div></div></section>
</SiteLayout>
