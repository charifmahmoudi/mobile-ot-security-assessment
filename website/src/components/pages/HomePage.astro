---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { bookingUrl, repo, sitePath, type Lang } from '../../lib/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const fr = lang === 'fr';
const base = import.meta.env.BASE_URL;
const evaluation = sitePath(base, lang, 'pilot');

const copy = fr ? {
  title: 'La maintenance commence demain — Atlas OT Scout',
  description: "Une histoire opérationnelle illustrée : comment Atlas OT Scout aide une équipe eau à préparer une intervention avec un périmètre borné, des preuves traçables et des inconnues explicites.",
  kicker: 'Cas opérateur illustratif · Station de traitement des eaux',
  h1: 'La maintenance commence demain.',
  intro: "Avant que le technicien ne touche l'armoire, l'équipe doit savoir ce qui est réellement là — et reconnaître honnêtement ce qu'elle ne sait pas encore.",
  primary: 'Examiner ce workflow avec nous',
  secondary: "Commencer l'histoire",
  disclaimer: "Cas synthétique fondé sur les exigences produit. Il illustre la méthode ; il ne constitue pas une preuve client.",
  questionLabel: 'La question opérationnelle',
  question: "Pouvons-nous préparer cette intervention sans élargir le risque pour le procédé ?",
  answer: "Atlas ne promet pas de tout découvrir. Il aide l'équipe à borner la question, utiliser la preuve la moins intrusive, conserver la provenance et transmettre les inconnues sans les maquiller en certitudes.",
  chaptersLabel: 'Un cas, cinq décisions',
  chaptersTitle: "La sécurité de l'intervention se décide avant la première connexion.",
  chaptersIntro: "Suivez la préparation depuis l'appel de la veille jusqu'au handoff du matin. Chaque étape répond à une question professionnelle précise.",
  steps: [
    {
      time: '16:42', label: "L'appel arrive", title: 'Demain, une pompe doit être maintenue.',
      body: "L'inventaire indique un contrôleur. Le schéma en montre une autre révision. Une observation réseau plus ancienne ne suffit pas à trancher. Le problème n'est pas de lancer un scan : c'est de préparer une intervention défendable sans perturber l'exploitation.",
      decision: 'Décision', decisionText: "Traiter l'écart comme une question de preuve, pas comme une invitation à découvrir plus large.",
    },
    {
      time: '17:10', label: 'Le cadre est posé', title: 'Définir exactement ce qui peut se passer.',
      body: "L'opérateur, le technicien et l'approbateur fixent l'équipement concerné, les exclusions, la fenêtre, les méthodes permises et les conditions d'arrêt. L'autorité reste locale, y compris sans Internet.",
      decision: 'Garde-fou', decisionText: "Une expiration, un détachement, une alarme ou une demande opérateur arrête l'action — sans comportement de repli.",
    },
    {
      time: '07:15', label: "Observer d'abord", title: "Réutiliser la preuve disponible avant de produire du trafic.",
      body: "Atlas conserve séparément le dossier attendu, la capture autorisée et les observations de terrain. Les valeurs d'origine ne sont pas écrasées. Une adresse, un port ou un OUI reste une observation ; ce n'est pas encore une identité confirmée.",
      decision: 'Principe', decisionText: "Passif et hors ligne d'abord. Une action active n'existe que pour un écart documenté et un objectif autorisé.",
    },
    {
      time: '07:42', label: "L'inconnu reste visible", title: "L'identité ne tient pas suffisamment.",
      body: "Le fournisseur et la fonction semblent cohérents, mais la révision reste en conflit. La preuve n'autorise pas une conclusion plus forte. Atlas marque l'identité probable, conserve la contradiction et protège l'équipement non résolu de l'intervention.",
      decision: 'Arrêt sûr', decisionText: "Pas de sweep, pas de lecture de registres, pas d'hypothèse silencieuse. L'incertitude modifie le plan de travail.",
    },
    {
      time: '08:05', label: 'Le handoff', title: 'La maintenance commence avec moins de suppositions.',
      body: "Le technicien reçoit un paquet concis : ce qui a été observé, les sources, les limites, la décision de revue et l'exception encore ouverte. La tâche autorisée peut avancer ; le contrôleur non résolu reste explicitement hors intervention.",
      decision: 'Résultat', decisionText: "Une décision de maintenance plus claire, avec une trace qu'un autre professionnel peut challenger.",
    },
  ],
  ledgerLabel: 'Dossier de preuve · 07:28',
  ledgerTitle: 'Atlas sépare les couches au lieu de fabriquer une seule “vérité”.',
  ledgerRows: [
    ['Attendu', 'PLC-PUMP-04 · révision 3', 'Déclaré'],
    ['Observé', '10.20.4.18 · trafic Modbus/TCP', 'Passif'],
    ['Identité', 'Fournisseur et produit cohérents', 'Probable'],
    ['Conflit', 'Révision différente', 'Non résolu'],
  ],
  methodsLabel: 'Ce que la méthode protège',
  methodsTitle: "Une meilleure preuve n'a de valeur que si elle respecte l'exploitation.",
  methods: [
    ['Le procédé', "Les conditions d'exploitation et l'autorité d'arrêt priment sur la collecte."],
    ['La décision', "Observation, affirmation, revue et conclusion restent des étapes distinctes."],
    ['Le handoff', "Sources, confiance, contradictions et limites voyagent avec le résultat."],
  ],
  boundariesTitle: 'Ce qu’Atlas fait — et ce qu’il refuse de prétendre.',
  does: ['Lie chaque observation à son contexte et à sa source', 'Aide à choisir la méthode adéquate la moins intrusive', 'Conserve les conflits et décisions de revue', 'Prépare un paquet vérifiable hors ligne'],
  doesNot: ['Ne prouve pas que les actifs non observés sont absents', 'Ne transforme pas un port ouvert en vulnérabilité', 'Ne remplace pas l’autorité de l’opérateur ou le jugement professionnel', 'Ne certifie ni conformité ni couverture réseau complète'],
  doesLabel: 'Atlas aide à', doesNotLabel: 'Atlas ne prétend pas',
  openLabel: 'Ingénierie inspectable',
  openTitle: "Le récit est simple. Les limites techniques restent publiques.",
  openBody: "Le site explique le problème humain. Le dépôt publie ce qui fonctionne aujourd'hui, le comportement réseau exact, le modèle de menace et les preuves de test.",
  ctaLabel: 'Votre prochain cas',
  ctaTitle: 'Quelle maintenance commence demain chez vous ?',
  ctaBody: "Apportez une question opérationnelle anonymisée. Nous examinerons le périmètre, l'autorité, la preuve disponible et les conditions d'un essai borné — sans présentation commerciale générique.",
  ctaSecondary: "Voir le cadre d'évaluation",
} : {
  title: 'Maintenance starts tomorrow — Atlas OT Scout',
  description: 'An illustrated operational story: how Atlas OT Scout helps a water team prepare maintenance with bounded scope, traceable evidence, and explicit unknowns.',
  kicker: 'Illustrative operator case · Water treatment station',
  h1: 'Maintenance starts tomorrow.',
  intro: 'Before the technician touches the cabinet, the team needs to know what is actually there—and be honest about what it still does not know.',
  primary: 'Review this workflow with us',
  secondary: 'Start the story',
  disclaimer: 'Synthetic case grounded in product requirements. It illustrates the method; it is not customer evidence.',
  questionLabel: 'The operational question',
  question: 'Can we prepare this intervention without expanding risk to the process?',
  answer: 'Atlas does not promise to discover everything. It helps the team bound the question, use the least intrusive adequate evidence, preserve provenance, and hand off unknowns without dressing them up as certainty.',
  chaptersLabel: 'One case, five decisions',
  chaptersTitle: 'Safe maintenance is decided before the first connection.',
  chaptersIntro: 'Follow the preparation from the call the evening before to the morning handoff. Each step answers one precise professional question.',
  steps: [
    {
      time: '16:42', label: 'The call arrives', title: 'A pump needs maintenance tomorrow.',
      body: 'The inventory names one controller. The drawing shows another revision. An older network observation cannot settle the difference. The problem is not to launch a scan; it is to prepare a defensible intervention without disturbing operations.',
      decision: 'Decision', decisionText: 'Treat the discrepancy as an evidence question, not an invitation to discover more broadly.',
    },
    {
      time: '17:10', label: 'The boundary is agreed', title: 'Define exactly what may happen.',
      body: 'The operator, technician, and security approver agree the equipment, exclusions, window, permitted methods, and stop conditions. Authority stays local, including when no Internet is available.',
      decision: 'Guardrail', decisionText: 'Expiry, detach, process alarm, or an operator request stops the action—with no fallback behavior.',
    },
    {
      time: '07:15', label: 'Observe first', title: 'Reuse available evidence before producing traffic.',
      body: 'Atlas keeps the expected record, authorized capture, and field observations separate. Original values are not overwritten. An address, port, or OUI remains an observation; it is not yet confirmed identity.',
      decision: 'Principle', decisionText: 'Passive and offline first. An active action exists only for a documented gap and an authorized purpose.',
    },
    {
      time: '07:42', label: 'The unknown stays visible', title: 'The identity does not hold strongly enough.',
      body: 'Vendor and function appear consistent, but the revision remains in conflict. The evidence does not support a stronger claim. Atlas marks the identity probable, retains the contradiction, and keeps the unresolved equipment out of the intervention.',
      decision: 'Safe stop', decisionText: 'No sweep, no register read, no silent assumption. The uncertainty changes the work plan.',
    },
    {
      time: '08:05', label: 'The handoff', title: 'Maintenance begins with fewer assumptions.',
      body: 'The technician receives a concise package: what was observed, the sources, limitations, review decision, and the open exception. The authorized task can proceed; the unresolved controller remains explicitly untouched.',
      decision: 'Outcome', decisionText: 'A clearer maintenance decision, with a trail another professional can challenge.',
    },
  ],
  ledgerLabel: 'Evidence case · 07:28',
  ledgerTitle: 'Atlas separates layers instead of manufacturing one “truth.”',
  ledgerRows: [
    ['Expected', 'PLC-PUMP-04 · revision 3', 'Declared'],
    ['Observed', '10.20.4.18 · Modbus/TCP traffic', 'Passive'],
    ['Identity', 'Vendor and product consistent', 'Probable'],
    ['Conflict', 'Revision differs', 'Unresolved'],
  ],
  methodsLabel: 'What the method protects',
  methodsTitle: 'Better evidence only matters when it respects operations.',
  methods: [
    ['The process', 'Operating conditions and local stop authority take priority over collection.'],
    ['The decision', 'Observation, claim, review, and conclusion remain distinct stages.'],
    ['The handoff', 'Sources, confidence, contradictions, and limitations travel with the result.'],
  ],
  boundariesTitle: 'What Atlas does—and what it refuses to claim.',
  does: ['Binds each observation to its context and source', 'Helps choose the least intrusive adequate method', 'Preserves conflicts and review decisions', 'Prepares an offline-verifiable package'],
  doesNot: ['Does not prove unobserved assets are absent', 'Does not turn an open port into a vulnerability', 'Does not replace operator authority or professional judgment', 'Does not certify compliance or complete network coverage'],
  doesLabel: 'Atlas helps', doesNotLabel: 'Atlas does not claim',
  openLabel: 'Inspectable engineering',
  openTitle: 'The story is simple. The technical limits remain public.',
  openBody: 'The website explains the human problem. The repository publishes what works today, exact network behavior, the threat model, and test evidence.',
  ctaLabel: 'Your next case',
  ctaTitle: 'What maintenance starts tomorrow for you?',
  ctaBody: 'Bring an anonymized operational question. We will review the scope, authority, available evidence, and conditions for a bounded evaluation—without a generic sales presentation.',
  ctaSecondary: 'See the evaluation framework',
};

const hero = `${base}media/maintenance-tomorrow-hero.webp`;
const scopeImage = `${base}media/maintenance-tomorrow-scope.webp`;
const handoffImage = `${base}media/maintenance-tomorrow-handoff.webp`;
---
<SiteLayout title={copy.title} description={copy.description} lang={lang} page="home">
  <section class="case-hero relative isolate min-h-[760px] overflow-hidden bg-navy text-white">
    <img class="absolute inset-0 size-full object-cover object-center" src={hero} alt={fr ? "Responsable d'exploitation arrêtant une intervention devant une armoire de contrôle" : 'Operations lead pausing an intervention beside a control cabinet'} width="1672" height="941" fetchpriority="high" />
    <div class="case-hero-shade absolute inset-0"></div>
    <div class="relative mx-auto flex min-h-[760px] max-w-7xl items-end px-5 pb-14 pt-28 sm:px-8 lg:items-center lg:pb-20 lg:pt-20">
      <div class="max-w-[700px]">
        <p class="case-kicker">{copy.kicker}</p>
        <h1 class="mt-5 max-w-3xl text-5xl font-black leading-[.96] tracking-[-.05em] sm:text-7xl lg:text-[5.8rem]">{copy.h1}</h1>
        <p class="mt-7 max-w-2xl text-lg leading-8 text-white/82 sm:text-xl">{copy.intro}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="case-button case-button-primary" href={bookingUrl} target="_blank" rel="noreferrer">{copy.primary}</a>
          <a class="case-button case-button-ghost" href="#case">{copy.secondary} ↓</a>
        </div>
        <p class="mt-7 max-w-xl border-l-2 border-aqua/65 pl-4 text-sm leading-6 text-white/62">{copy.disclaimer}</p>
      </div>
    </div>
  </section>

  <section class="border-b border-border bg-white">
    <div class="mx-auto grid max-w-7xl gap-8 px-5 py-16 sm:px-8 lg:grid-cols-[.72fr_1.28fr] lg:items-start lg:py-20">
      <p class="section-label pt-1">{copy.questionLabel}</p>
      <div>
        <h2 class="max-w-4xl text-3xl font-black leading-tight tracking-[-.035em] text-navy sm:text-5xl">{copy.question}</h2>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-muted">{copy.answer}</p>
      </div>
    </div>
  </section>

  <section id="case" class="scroll-mt-24 bg-paper">
    <div class="mx-auto max-w-7xl px-5 pb-8 pt-20 sm:px-8 lg:pt-28">
      <p class="section-label">{copy.chaptersLabel}</p>
      <div class="mt-3 grid gap-6 lg:grid-cols-[1.25fr_.75fr] lg:items-end">
        <h2 class="text-4xl font-black leading-[1.04] tracking-[-.045em] text-navy sm:text-6xl">{copy.chaptersTitle}</h2>
        <p class="text-lg leading-8 text-muted">{copy.chaptersIntro}</p>
      </div>
    </div>

    <article class="story-chapter mx-auto grid max-w-7xl gap-8 px-5 py-16 sm:px-8 lg:grid-cols-[.38fr_1fr] lg:py-24">
      <header class="story-marker">
        <span>01</span><time>{copy.steps[0].time}</time>
      </header>
      <div class="grid gap-8 lg:grid-cols-[1.05fr_.95fr] lg:items-start">
        <div>
          <p class="case-eyebrow">{copy.steps[0].label}</p>
          <h3 class="mt-3 text-4xl font-black tracking-[-.035em] text-navy">{copy.steps[0].title}</h3>
          <p class="mt-5 text-lg leading-8 text-muted">{copy.steps[0].body}</p>
        </div>
        <aside class="decision-note">
          <p>{copy.steps[0].decision}</p><strong>{copy.steps[0].decisionText}</strong>
        </aside>
      </div>
    </article>

    <article class="story-chapter border-y border-border bg-white">
      <div class="mx-auto grid max-w-7xl gap-8 px-5 py-16 sm:px-8 lg:grid-cols-[.38fr_1fr] lg:py-24">
        <header class="story-marker"><span>02</span><time>{copy.steps[1].time}</time></header>
        <div>
          <div class="grid gap-8 lg:grid-cols-[.92fr_1.08fr] lg:items-end">
            <div>
              <p class="case-eyebrow">{copy.steps[1].label}</p>
              <h3 class="mt-3 text-4xl font-black tracking-[-.035em] text-navy">{copy.steps[1].title}</h3>
              <p class="mt-5 text-lg leading-8 text-muted">{copy.steps[1].body}</p>
            </div>
            <aside class="decision-note"><p>{copy.steps[1].decision}</p><strong>{copy.steps[1].decisionText}</strong></aside>
          </div>
          <figure class="story-image mt-10">
            <img src={scopeImage} alt={fr ? "Équipe définissant le périmètre et l'arrêt local avant l'intervention" : 'Team agreeing scope and local stop authority before the intervention'} width="1672" height="941" loading="lazy" decoding="async" />
          </figure>
        </div>
      </div>
    </article>

    <article class="story-chapter bg-navy text-white">
      <div class="blueprint-grid mx-auto grid max-w-7xl gap-8 px-5 py-16 sm:px-8 lg:grid-cols-[.38fr_1fr] lg:py-24">
        <header class="story-marker story-marker-dark"><span>03</span><time>{copy.steps[2].time}</time></header>
        <div class="grid gap-10 lg:grid-cols-[.88fr_1.12fr] lg:items-start">
          <div>
            <p class="case-eyebrow text-aqua">{copy.steps[2].label}</p>
            <h3 class="mt-3 text-4xl font-black tracking-[-.035em]">{copy.steps[2].title}</h3>
            <p class="mt-5 text-lg leading-8 text-white/68">{copy.steps[2].body}</p>
            <aside class="decision-note decision-note-dark mt-7"><p>{copy.steps[2].decision}</p><strong>{copy.steps[2].decisionText}</strong></aside>
          </div>
          <div class="evidence-ledger">
            <div class="border-b border-white/12 px-5 py-4">
              <p class="font-mono text-xs uppercase tracking-[.12em] text-aqua">{copy.ledgerLabel}</p>
              <h4 class="mt-2 text-lg font-bold">{copy.ledgerTitle}</h4>
            </div>
            <dl>
              {copy.ledgerRows.map(([term, value, state], i) => (
                <div class={`grid gap-3 px-5 py-4 sm:grid-cols-[.55fr_1.25fr_.6fr] ${i < copy.ledgerRows.length - 1 ? 'border-b border-white/10' : ''}`}>
                  <dt class="text-sm font-bold text-white/55">{term}</dt>
                  <dd class="font-mono text-sm text-white/90">{value}</dd>
                  <dd class={`text-sm font-bold sm:text-right ${i === copy.ledgerRows.length - 1 ? 'text-warning' : 'text-aqua'}`}>{state}</dd>
                </div>
              ))}
            </dl>
          </div>
        </div>
      </div>
    </article>

    <article class="story-chapter border-b border-border bg-sand">
      <div class="mx-auto grid max-w-7xl gap-8 px-5 py-16 sm:px-8 lg:grid-cols-[.38fr_1fr] lg:py-24">
        <header class="story-marker"><span>04</span><time>{copy.steps[3].time}</time></header>
        <div class="grid gap-8 lg:grid-cols-[1.05fr_.95fr] lg:items-start">
          <div>
            <p class="case-eyebrow text-amber">{copy.steps[3].label}</p>
            <h3 class="mt-3 text-4xl font-black tracking-[-.035em] text-navy">{copy.steps[3].title}</h3>
            <p class="mt-5 text-lg leading-8 text-muted">{copy.steps[3].body}</p>
          </div>
          <aside class="safe-stop">
            <p>{copy.steps[3].decision}</p>
            <strong>{copy.steps[3].decisionText}</strong>
          </aside>
        </div>
      </div>
    </article>

    <article class="story-chapter bg-white">
      <div class="mx-auto grid max-w-7xl gap-8 px-5 py-16 sm:px-8 lg:grid-cols-[.38fr_1fr] lg:py-24">
        <header class="story-marker"><span>05</span><time>{copy.steps[4].time}</time></header>
        <div>
          <div class="grid gap-8 lg:grid-cols-[.92fr_1.08fr] lg:items-end">
            <div>
              <p class="case-eyebrow">{copy.steps[4].label}</p>
              <h3 class="mt-3 text-4xl font-black tracking-[-.035em] text-navy">{copy.steps[4].title}</h3>
              <p class="mt-5 text-lg leading-8 text-muted">{copy.steps[4].body}</p>
            </div>
            <aside class="decision-note"><p>{copy.steps[4].decision}</p><strong>{copy.steps[4].decisionText}</strong></aside>
          </div>
          <figure class="story-image mt-10">
            <img src={handoffImage} alt={fr ? "Responsable transmettant un dossier de preuve à l'équipe de maintenance" : 'Operations lead handing an evidence package to the maintenance team'} width="1672" height="941" loading="lazy" decoding="async" />
          </figure>
        </div>
      </div>
    </article>
  </section>

  <section id="methode" class="scroll-mt-24 border-y border-border bg-paper">
    <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:py-28">
      <p class="section-label">{copy.methodsLabel}</p>
      <h2 class="mt-3 max-w-4xl text-4xl font-black tracking-[-.04em] text-navy sm:text-5xl">{copy.methodsTitle}</h2>
      <div class="mt-10 grid gap-px overflow-hidden rounded-[18px] border border-border bg-border md:grid-cols-3">
        {copy.methods.map(([title, body], i) => (
          <article class="bg-white p-7 lg:p-9">
            <span class="font-mono text-xs font-bold text-blue">0{i + 1}</span>
            <h3 class="mt-8 text-2xl font-black tracking-[-.025em] text-navy">{title}</h3>
            <p class="mt-4 leading-7 text-muted">{body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:py-28">
      <h2 class="max-w-4xl text-4xl font-black tracking-[-.04em] text-navy sm:text-5xl">{copy.boundariesTitle}</h2>
      <div class="mt-10 grid overflow-hidden rounded-[18px] border border-border lg:grid-cols-2">
        <div class="p-7 lg:p-9">
          <p class="case-eyebrow text-teal">{copy.doesLabel}</p>
          <ul class="mt-6 space-y-4">
            {copy.does.map(item => <li class="boundary-item boundary-item-yes">{item}</li>)}
          </ul>
        </div>
        <div class="border-t border-border bg-surface p-7 lg:border-l lg:border-t-0 lg:p-9">
          <p class="case-eyebrow text-amber">{copy.doesNotLabel}</p>
          <ul class="mt-6 space-y-4">
            {copy.doesNot.map(item => <li class="boundary-item boundary-item-no">{item}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-aqua/15 bg-navy text-white">
    <div class="mx-auto grid max-w-7xl gap-10 px-5 py-20 sm:px-8 lg:grid-cols-[.8fr_1.2fr] lg:items-center">
      <div>
        <p class="case-eyebrow text-aqua">{copy.openLabel}</p>
        <h2 class="mt-3 text-4xl font-black tracking-[-.04em] sm:text-5xl">{copy.openTitle}</h2>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-white/65">{copy.openBody}</p>
      </div>
      <div class="overflow-hidden rounded-[16px] border border-white/12 bg-white/[.045]">
        {[
          [fr ? 'Implémentation et limites actuelles' : 'Current implementation and limitations', `${repo}/blob/main/IMPLEMENTATION.md`],
          [fr ? 'Exécution réseau exacte' : 'Exact network execution', `${repo}/blob/main/docs/architecture/NETWORK-EXECUTION.md`],
          [fr ? 'Méthode d’évaluation' : 'Assessment method', `${repo}/blob/main/docs/poc/ASSESSMENT-METHOD.md`],
          [fr ? 'Sécurité et modèle de menace' : 'Security and threat model', `${repo}/blob/main/docs/architecture/SECURITY-AND-THREAT-MODEL.md`],
        ].map(([label,href], i) => <a class={`flex items-center justify-between px-5 py-4 text-sm font-bold transition hover:bg-white/[.07] hover:text-aqua ${i < 3 ? 'border-b border-white/10' : ''}`} href={href}><span>{label}</span><span aria-hidden="true">↗</span></a>)}
      </div>
    </div>
  </section>

  <section class="bg-blue text-white">
    <div class="mx-auto max-w-5xl px-5 py-20 text-center sm:px-8 lg:py-28">
      <p class="case-eyebrow text-white/65">{copy.ctaLabel}</p>
      <h2 class="mt-4 text-4xl font-black tracking-[-.045em] sm:text-6xl">{copy.ctaTitle}</h2>
      <p class="mx-auto mt-6 max-w-3xl text-lg leading-8 text-white/78">{copy.ctaBody}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a class="case-button bg-white text-navy hover:bg-aqua" href={bookingUrl} target="_blank" rel="noreferrer">{copy.primary} →</a>
        <a class="case-button border border-white/30 text-white hover:bg-white/10" href={evaluation}>{copy.ctaSecondary}</a>
      </div>
    </div>
  </section>
</SiteLayout>
