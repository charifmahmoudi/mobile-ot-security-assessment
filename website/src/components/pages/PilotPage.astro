---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { bookingUrl, repo, type Lang } from '../../lib/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const fr = lang === 'fr';
const base = import.meta.env.BASE_URL;

const copy = fr ? {
  title: 'Évaluation méthodologique — Atlas OT Scout',
  description: "Évaluer Atlas sur une question de preuve OT bornée avant d'envisager un pilote appareil ou une intégration plus large.",
  label: 'Évaluation méthodologique',
  h1: 'Testez Atlas contre une exigence réelle de votre méthode.',
  intro: "La première étape n'est pas un déploiement. C'est une revue privée du modèle de preuve, des contrôles, des limites et du workflow de QA autour d'un cas anonymisé.",
  cta: 'Planifier la revue',
  pathLabel: "Progression d'évaluation",
  pathTitle: "Du challenge méthodologique à une décision d'évaluation bornée.",
  steps: [
    ['01','Question','Quelle affirmation ou décision OT doit être défendable ?'],
    ['02','Méthode','Quelles preuves, rôles et gates votre méthode exige-t-elle ?'],
    ['03','Exemple','Quel cas anonymisé ou synthétique permet de tester le fit ?'],
    ['04','Revue','Où Atlas conserve-t-il — ou perd-il — le contexte nécessaire ?'],
    ['05','Écart','Quels contrôles, exports ou intégrations restent manquants ?'],
    ['06','Périmètre','Une évaluation appareil de 30 jours est-elle justifiée et sûre ?'],
    ['07','Décision','Continuer, modifier, intégrer, construire soi-même ou arrêter ?'],
  ],
  brings: 'Vous apportez',
  bringsItems: ["Une question d'audit ou de réconciliation",'Les exigences de votre méthode ou QA','Un exemple anonymisé ou synthétique','Les contraintes de preuve et de conservation','Le critère qui permettrait de conclure au fit'],
  reviewLabel: 'La revue examine',
  reviewTitle: 'La preuve, la décision et les limites — séparément.',
  reviewItems: [
    ['Provenance','La source et le contexte nécessaires à la réutilisation de la preuve.'],
    ['Identité','Les attributs qui soutiennent réellement une affirmation sur un actif.'],
    ['Confiance et conflit','Les raisons pour lesquelles une correspondance reste probable ou non résolue.'],
    ['Autorisation','La portée, les exclusions et les opérations réseau admises.'],
    ['Revue','Le rôle et la décision de la personne qui accepte ou rejette la conclusion.'],
    ['Handoff','Ce que votre rapport ou processus QA devra recevoir.'],
  ],
  nextLabel: 'Étape suivante optionnelle',
  nextTitle: "Une évaluation appareil gratuite de 30 jours, seulement si le fit mérite d'être mesuré.",
  nextBody: "L'évaluation porte sur une question, une zone, des méthodes autorisées et des critères de réussite convenus. Elle peut être prolongée une fois jusqu'à 60 jours par accord mutuel. Elle ne crée ni abonnement automatique ni obligation de licence propriétaire.",
  limitsTitle: 'Le prototype a des limites publiées.',
  limitsBody: "L'application exécute aujourd'hui des parcours de preuve, de réconciliation et de revue vérifiés en CI. Le package final signé HTML/PDF/JSON/CSV, l'intégration complète du daemon sur téléphone et la qualification physique restent des travaux de release publiés dans IMPLEMENTATION.md.",
  success: 'Décision utile',
  successTitle: "Atlas améliore-t-il la défendabilité ou l'effort de revue de votre workflow ?",
  successBody: "Le résultat doit identifier un gain mesurable, un fit insuffisant ou les changements exacts nécessaires. L'intérêt général pour la technologie n'est pas un critère de réussite.",
} : {
  title: 'Methodology evaluation — Atlas OT Scout',
  description: 'Evaluate Atlas against one bounded OT evidence question before considering a device pilot or broader integration.',
  label: 'Methodology evaluation',
  h1: 'Test Atlas against a real requirement in your method.',
  intro: 'The first step is not a deployment. It is a private review of the evidence model, controls, limitations, and QA workflow around an anonymized case.',
  cta: 'Book the review',
  pathLabel: 'Evaluation progression',
  pathTitle: 'From methodology challenge to a bounded evaluation decision.',
  steps: [
    ['01','Question','Which OT claim or decision must be defensible?'],
    ['02','Method','Which evidence, roles, and gates does your method require?'],
    ['03','Example','Which anonymized or synthetic case can test the fit?'],
    ['04','Review','Where does Atlas preserve—or lose—necessary context?'],
    ['05','Gap','Which controls, exports, or integrations are still missing?'],
    ['06','Scope','Is a free 30-day device evaluation justified and safe?'],
    ['07','Decision','Continue, modify, integrate, self-build, or stop?'],
  ],
  brings: 'You bring',
  bringsItems: ['One assessment or reconciliation question','Your methodology or QA requirements','An anonymized or synthetic example','Evidence and retention constraints','A criterion that would demonstrate fit'],
  reviewLabel: 'The review examines',
  reviewTitle: 'Evidence, decision, and limitations—separately.',
  reviewItems: [
    ['Provenance','The source and context required to reuse the evidence.'],
    ['Identity','The attributes that genuinely support an asset claim.'],
    ['Confidence and conflict','Why a match remains probable or unresolved.'],
    ['Authorization','Admitted scope, exclusions, and network operations.'],
    ['Review','The role and decision of the person accepting or rejecting the conclusion.'],
    ['Handoff','What your reporting or QA process would need to receive.'],
  ],
  nextLabel: 'Optional next step',
  nextTitle: 'A free 30-day device evaluation, only when the fit deserves measurement.',
  nextBody: 'The evaluation covers one question, one area, authorized methods, and agreed success criteria. It may be extended once to a maximum of 60 days by mutual agreement. It creates no automatic subscription or proprietary licence obligation.',
  limitsTitle: 'The prototype has published limitations.',
  limitsBody: 'The application currently executes CI-verified evidence, reconciliation, and review paths. Signed final HTML/PDF/JSON/CSV packages, complete on-phone daemon integration, and physical qualification remain published release work in IMPLEMENTATION.md.',
  success: 'Useful decision',
  successTitle: 'Does Atlas improve the defensibility or review effort of your workflow?',
  successBody: 'The outcome should identify a measurable gain, insufficient fit, or the exact changes required. General interest in the technology is not a success criterion.',
};
---
<SiteLayout title={copy.title} description={copy.description} lang={lang} page="pilot">
  <section class="relative overflow-hidden bg-surface">
    <div class="blueprint-grid-light absolute inset-0 opacity-65"></div>
    <div class="relative mx-auto grid max-w-7xl gap-10 px-5 py-16 sm:px-8 lg:grid-cols-[.82fr_1.18fr] lg:items-center lg:py-20">
      <div>
        <p class="section-label">{copy.label}</p>
        <h1 class="mt-5 text-5xl font-black leading-[1.04] tracking-[-0.045em] text-navy sm:text-6xl">{copy.h1}</h1>
        <p class="mt-6 max-w-2xl text-xl leading-9 text-muted">{copy.intro}</p>
        <a class="mt-8 inline-block rounded-[11px] bg-blue px-5 py-3 text-sm font-bold text-white shadow-[0_8px_22px_rgba(36,87,214,.22)] hover:bg-navy" href={bookingUrl} target="_blank" rel="noreferrer">{copy.cta} →</a>
      </div>
      <figure class="app-frame app-shadow overflow-hidden bg-white">
        <img class="block aspect-video w-full object-cover" src={`${base}media/atlas-handoff.jpg`} alt={fr ? 'Application Atlas OT Scout pendant le workflow de revue enregistré' : 'Atlas OT Scout application during the recorded review workflow'} />
        <figcaption class="flex items-center justify-between border-t border-border bg-white px-4 py-3 text-xs text-muted"><span>{fr ? 'Sortie réelle de l’émulateur' : 'Actual emulator output'}</span><span class="font-bold text-blue">{fr ? 'Preuve → revue' : 'Evidence → review'}</span></figcaption>
      </figure>
    </div>
  </section>

  <section class="border-y border-border bg-white">
    <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8">
      <p class="section-label">{copy.pathLabel}</p>
      <h2 class="mt-3 max-w-3xl text-4xl font-black tracking-[-0.035em] text-navy sm:text-5xl">{copy.pathTitle}</h2>
      <div class="mt-10 overflow-x-auto pb-2">
        <div class="grid min-w-[980px] grid-cols-7 items-stretch gap-2">
          {copy.steps.map(([n,title,body], i) => (
            <div class={`app-frame relative bg-white p-4 ${i === 3 ? 'border-blue shadow-[inset_0_0_0_1px_#2457d6]' : ''}`}>
              <span class="text-xs font-black text-blue">{n}</span>
              <h3 class="mt-5 font-bold text-navy">{title}</h3>
              <p class="mt-2 text-xs leading-5 text-muted">{body}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface">
    <div class="mx-auto grid max-w-7xl gap-5 px-5 py-20 sm:px-8 lg:grid-cols-2">
      <div class="app-frame bg-white p-6 sm:p-7">
        <p class="section-label">{copy.brings}</p>
        <ul class="mt-6 divide-y divide-border">
          {copy.bringsItems.map((item,i) => <li class="flex gap-4 py-4 first:pt-0 last:pb-0"><span class="text-xs font-black text-blue">0{i + 1}</span><span class="font-semibold text-navy">{item}</span></li>)}
        </ul>
      </div>
      <div class="app-frame overflow-hidden bg-white">
        <div class="border-b border-border px-6 py-5"><p class="section-label">{copy.reviewLabel}</p><h2 class="mt-3 text-2xl font-black text-navy">{copy.reviewTitle}</h2></div>
        {copy.reviewItems.map(([title,body],i) => <div class={`grid gap-1 px-5 py-3.5 sm:grid-cols-[.72fr_1.28fr] sm:gap-5 ${i < copy.reviewItems.length - 1 ? 'border-b border-border' : ''}`}><strong class="text-sm text-navy">{title}</strong><span class="text-sm leading-6 text-muted">{body}</span></div>)}
      </div>
    </div>
  </section>

  <section class="border-y border-border bg-white">
    <div class="mx-auto grid max-w-7xl gap-8 px-5 py-20 sm:px-8 lg:grid-cols-[1fr_.82fr] lg:items-start">
      <div>
        <p class="section-label">{copy.nextLabel}</p>
        <h2 class="mt-3 text-4xl font-black tracking-[-0.035em] text-navy">{copy.nextTitle}</h2>
        <p class="mt-5 max-w-3xl text-lg leading-8 text-muted">{copy.nextBody}</p>
        <a class="mt-7 inline-block rounded-[11px] bg-blue px-5 py-3 text-sm font-bold text-white hover:bg-navy" href={bookingUrl} target="_blank" rel="noreferrer">{copy.cta} →</a>
      </div>
      <aside class="app-frame bg-pale-amber p-6">
        <h3 class="text-xl font-bold text-navy">{copy.limitsTitle}</h3>
        <p class="mt-3 text-sm leading-6 text-muted">{copy.limitsBody}</p>
        <a class="mt-5 inline-block text-sm font-bold text-blue hover:text-navy" href={`${repo}/blob/main/IMPLEMENTATION.md`}>{fr ? 'Lire la baseline exécutable' : 'Read the executable baseline'} ↗</a>
      </aside>
    </div>
  </section>

  <section class="bg-pale-blue">
    <div class="mx-auto grid max-w-7xl gap-8 px-5 py-20 sm:px-8 lg:grid-cols-[1fr_.72fr] lg:items-center">
      <div>
        <p class="section-label">{copy.success}</p>
        <h2 class="mt-3 max-w-4xl text-4xl font-black tracking-[-0.035em] text-navy sm:text-5xl">{copy.successTitle}</h2>
        <p class="mt-5 max-w-3xl text-lg leading-8 text-muted">{copy.successBody}</p>
      </div>
      <div class="app-frame bg-white p-6">
        <p class="text-sm font-bold text-navy">{fr ? 'Décision issue de la revue' : 'Review decision'}</p>
        <div class="mt-4 grid gap-2 text-sm">
          <span class="rounded-[9px] bg-pale-teal px-4 py-3 font-bold text-success">{fr ? 'Tester sur un périmètre borné' : 'Test on a bounded scope'}</span>
          <span class="rounded-[9px] bg-pale-amber px-4 py-3 font-bold text-amber">{fr ? 'Adapter puis re-challenger' : 'Adapt and challenge again'}</span>
          <span class="rounded-[9px] bg-surface px-4 py-3 font-bold text-muted">{fr ? 'Construire / intégrer indépendamment' : 'Self-build / integrate independently'}</span>
          <span class="rounded-[9px] bg-white px-4 py-3 font-bold text-danger ring-1 ring-danger/25">{fr ? 'Arrêter : fit insuffisant' : 'Stop: insufficient fit'}</span>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>
