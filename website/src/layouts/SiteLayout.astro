---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { sitePath, type Lang, type Page } from '../lib/site';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  page: Page;
}

const { title, description, lang, page } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const otherLang: Lang = lang === 'fr' ? 'en' : 'fr';
const alternate = new URL(sitePath(import.meta.env.BASE_URL, otherLang, page), Astro.site);
const image = new URL(`${import.meta.env.BASE_URL}media/atlas-reconcile.jpg`, Astro.site);
const skip = lang === 'fr' ? 'Aller au contenu' : 'Skip to content';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B1F33" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={otherLang} href={alternate} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body>
    <a class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-white focus:px-4 focus:py-2" href="#main">{skip}</a>
    <Header lang={lang} page={page} />
    <main id="main"><slot /></main>
    <Footer lang={lang} />
  </body>
</html>
