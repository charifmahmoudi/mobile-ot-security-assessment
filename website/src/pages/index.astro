---
import SiteLayout from '../layouts/SiteLayout.astro';
import ReconciliationPanel from '../components/ReconciliationPanel.astro';
const base = import.meta.env.BASE_URL;
const repo = 'https://github.com/charifmahmoudi/mobile-ot-security-assessment';
---
<SiteLayout title="Atlas OT Scout — Defensible OT asset reconciliation" description="Reconcile expected OT asset records with bounded field evidence and return a reviewed operational baseline with explicit uncertainty and provenance.">
  <section class="relative overflow-hidden bg-ink text-white">
    <div class="absolute inset-0 grid-fade opacity-30"></div>
    <div class="relative mx-auto grid min-h-[720px] max-w-7xl items-center gap-14 px-5 py-20 sm:px-8 lg:grid-cols-[1.02fr_.98fr] lg:py-24">
      <div class="max-w-2xl">
        <p class="reveal font-mono text-xs uppercase tracking-[0.2em] text-atlas">Atlas OT Scout · P0-WATER</p>
        <h1 class="reveal reveal-delay-1 mt-5 text-5xl font-semibold tracking-[-0.055em] sm:text-6xl lg:text-7xl">Make OT asset inventories defensible.</h1>
        <p class="reveal reveal-delay-2 mt-7 max-w-xl text-lg leading-8 text-white/65">Reconcile expected asset records with bounded field evidence. Preserve uncertainty, investigate only the gaps that matter, and return a reviewed operational baseline.</p>
        <div class="reveal reveal-delay-3 mt-9 flex flex-wrap gap-3"><a class="rounded-full bg-atlas px-5 py-3 text-sm font-semibold text-ink transition hover:brightness-110" href="#product">See the workflow</a><a class="rounded-full border border-white/18 px-5 py-3 text-sm font-semibold text-white transition hover:border-white/35 hover:bg-white/5" href={`${base}pilot/`}>Review pilot scope</a></div>
        <div class="mt-10 flex flex-wrap gap-x-5 gap-y-2 font-mono text-[11px] uppercase tracking-[0.14em] text-white/40"><span>Offline by design</span><span>Passive first</span><span>Evidence linked</span><span>Reviewed</span></div>
      </div>
      <ReconciliationPanel />
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-24 sm:px-8">
    <div class="max-w-3xl"><p class="font-mono text-xs uppercase tracking-[0.18em] text-steel">The problem</p><h2 class="mt-4 text-4xl font-semibold tracking-[-0.04em] sm:text-5xl">Your asset register is an assertion. Field evidence determines how much of it you can trust.</h2></div>
    <div class="mt-12 grid gap-4 md:grid-cols-3">
      <article class="rounded-3xl border border-ink/10 bg-surface p-7"><span class="font-mono text-xs text-muted">01</span><h3 class="mt-8 text-xl font-semibold">Expected, not corroborated</h3><p class="mt-3 leading-7 text-steel">A record exists in the accepted inventory, but available evidence does not adequately support it.</p></article>
      <article class="rounded-3xl border border-ink/10 bg-surface p-7"><span class="font-mono text-xs text-conflict">02</span><h3 class="mt-8 text-xl font-semibold">Identity conflict</h3><p class="mt-3 leading-7 text-steel">Observed model, serial, firmware or other material identity evidence disagrees with the expected record.</p></article>
      <article class="rounded-3xl border border-ink/10 bg-surface p-7"><span class="font-mono text-xs text-atlas">03</span><h3 class="mt-8 text-xl font-semibold">Observed, not expected</h3><p class="mt-3 leading-7 text-steel">An OT endpoint appears in approved evidence without an accepted inventory match.</p></article>
    </div>
  </section>

  <section class="bg-surface"><div class="mx-auto grid max-w-7xl gap-12 px-5 py-24 sm:px-8 lg:grid-cols-[.8fr_1.2fr] lg:items-center"><div><p class="font-mono text-xs uppercase tracking-[0.18em] text-steel">The outcome</p><h2 class="mt-4 text-4xl font-semibold tracking-[-0.04em] sm:text-5xl">A clearer operating baseline after one bounded assessment.</h2><p class="mt-6 max-w-xl text-lg leading-8 text-steel">Atlas is designed to make discrepancies and uncertainty explicit instead of silently converting weak observations into authoritative inventory.</p></div><div class="grid grid-cols-2 gap-3 sm:grid-cols-3"><div class="rounded-3xl bg-ink p-6 text-white"><strong class="text-4xl">18</strong><span class="mt-8 block text-sm text-white/45">expected assets</span></div><div class="rounded-3xl bg-evidence/10 p-6"><strong class="text-4xl text-evidence">12</strong><span class="mt-8 block text-sm text-steel">corroborated</span></div><div class="rounded-3xl bg-signal/10 p-6"><strong class="text-4xl text-signal">2</strong><span class="mt-8 block text-sm text-steel">probable</span></div><div class="rounded-3xl bg-conflict/10 p-6"><strong class="text-4xl text-conflict">1</strong><span class="mt-8 block text-sm text-steel">identity conflict</span></div><div class="rounded-3xl bg-atlas/10 p-6"><strong class="text-4xl text-atlas">1</strong><span class="mt-8 block text-sm text-steel">unexpected endpoint</span></div><div class="rounded-3xl bg-muted/15 p-6"><strong class="text-4xl text-steel">2</strong><span class="mt-8 block text-sm text-steel">not observed</span></div></div></div></section>

  <section id="product" class="mx-auto max-w-7xl scroll-mt-24 px-5 py-24 sm:px-8"><div class="max-w-3xl"><p class="font-mono text-xs uppercase tracking-[0.18em] text-steel">How Atlas works</p><h2 class="mt-4 text-4xl font-semibold tracking-[-0.04em] sm:text-5xl">From a question to a reviewed answer.</h2></div><ol class="mt-12 grid gap-px overflow-hidden rounded-3xl border border-ink/10 bg-ink/10 lg:grid-cols-5">{[['01','Scope','Define the exact process area, assessment question, exclusions and decision owner.'],['02','Evidence','Use the least intrusive adequate source: imported, passive, physical or explicitly authorized active evidence.'],['03','Review','Preserve raw observations and provenance before accepting identity or inventory changes.'],['04','Reconcile','Make corroborated, probable, conflicting, unexpected and not-observed states explicit.'],['05','Handoff','Review material conclusions and return the baseline, exceptions, evidence and limitations.']].map(([n,title,copy]) => (<li class="bg-paper p-6"><span class="font-mono text-xs text-atlas">{n}</span><h3 class="mt-8 text-lg font-semibold">{title}</h3><p class="mt-3 text-sm leading-6 text-steel">{copy}</p></li>))}</ol></section>

  <section class="bg-ink text-white"><div class="mx-auto max-w-7xl px-5 py-24 sm:px-8"><div class="max-w-3xl"><p class="font-mono text-xs uppercase tracking-[0.18em] text-atlas">Where it helps</p><h2 class="mt-4 text-4xl font-semibold tracking-[-0.04em] sm:text-5xl">Start where evidence can change a real decision.</h2></div><div class="mt-12 grid gap-4 md:grid-cols-3"><article class="rounded-3xl border border-white/10 bg-white/[.035] p-7"><h3 class="text-xl font-semibold">Asset baseline reconciliation</h3><p class="mt-3 leading-7 text-white/55">Test whether available evidence supports the asset baseline currently accepted by operations.</p></article><article class="rounded-3xl border border-white/10 bg-white/[.035] p-7"><h3 class="text-xl font-semibold">Commissioning &amp; handover</h3><p class="mt-3 leading-7 text-white/55">Expose identity and inventory discrepancies before project records become operational truth.</p></article><article class="rounded-3xl border border-white/10 bg-white/[.035] p-7"><h3 class="text-xl font-semibold">Pre-maintenance baseline</h3><p class="mt-3 leading-7 text-white/55">Establish a bounded evidence-backed starting state before maintenance or modernization work.</p></article></div><div class="mt-10 flex flex-wrap items-center justify-between gap-5 rounded-3xl border border-atlas/25 bg-atlas/[.07] p-6"><p class="max-w-3xl text-white/70"><strong class="text-white">One identity gap, not a broad scan.</strong> Where specifically authorized, Atlas can use an exact bounded identity operation to investigate a documented uncertainty.</p><a class="whitespace-nowrap text-sm font-semibold text-atlas hover:text-white" href={`${base}safety/`}>See safety boundaries →</a></div></div></section>

  <section class="mx-auto max-w-7xl px-5 py-24 sm:px-8"><div class="grid gap-10 rounded-[2rem] border border-ink/10 bg-surface p-7 sm:p-10 lg:grid-cols-[1fr_.8fr] lg:items-center"><div><p class="font-mono text-xs uppercase tracking-[0.18em] text-steel">Open engineering</p><h2 class="mt-4 text-3xl font-semibold tracking-[-0.035em] sm:text-4xl">Inspect the engineering, not just the claims.</h2><p class="mt-5 max-w-2xl leading-7 text-steel">Current implementation, exact network behavior, security boundaries and verification evidence are maintained openly in the repository.</p></div><div class="grid gap-2 text-sm"><a class="rounded-xl border border-ink/10 px-4 py-3 font-semibold hover:border-atlas/40" href={`${repo}/blob/main/IMPLEMENTATION.md`}>Current implementation <span class="float-right text-steel">↗</span></a><a class="rounded-xl border border-ink/10 px-4 py-3 font-semibold hover:border-atlas/40" href={`${repo}/blob/main/docs/architecture/NETWORK-EXECUTION.md`}>Network boundaries <span class="float-right text-steel">↗</span></a><a class="rounded-xl border border-ink/10 px-4 py-3 font-semibold hover:border-atlas/40" href={`${repo}/tree/main/docs/testing`}>Verification evidence <span class="float-right text-steel">↗</span></a><a class="rounded-xl border border-ink/10 px-4 py-3 font-semibold hover:border-atlas/40" href={repo}>Source code <span class="float-right text-steel">↗</span></a></div></div></section>

  <section class="border-t border-ink/10 bg-paper"><div class="mx-auto max-w-4xl px-5 py-24 text-center sm:px-8"><p class="font-mono text-xs uppercase tracking-[0.18em] text-steel">Controlled evaluation</p><h2 class="mt-4 text-4xl font-semibold tracking-[-0.04em] sm:text-5xl">Start with one real OT evidence question.</h2><p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-steel">A useful pilot is bounded to a process area, an agreed evidence question, permitted collection methods and a result that can change a customer decision.</p><a class="mt-8 inline-block rounded-full bg-ink px-6 py-3 text-sm font-semibold text-white transition hover:bg-graphite" href={`${base}pilot/`}>Review the customer pilot</a></div></section>
</SiteLayout>
