---
import SiteLayout from '../layouts/SiteLayout.astro';
import ProductMedia from '../components/ProductMedia.astro';
import ReconciliationDiagram from '../components/ReconciliationDiagram.astro';
const base = import.meta.env.BASE_URL;
const repo = 'https://github.com/charifmahmoudi/mobile-ot-security-assessment';
---
<SiteLayout title="Atlas OT Scout — Evidence-backed OT asset reconciliation" description="Atlas OT Scout helps authorized assessors reconcile expected OT asset records with bounded field evidence and return a reviewed operational baseline.">
  <section class="relative overflow-hidden bg-navy text-white">
    <div class="blueprint-grid absolute inset-0 opacity-45"></div>
    <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-5 py-16 sm:px-8 lg:min-h-[710px] lg:grid-cols-[.88fr_1.12fr] lg:py-20">
      <div class="max-w-xl">
        <div class="mb-6 flex flex-wrap gap-2">
          <span class="status-chip border-aqua/35 bg-aqua/10 text-aqua">Offline</span>
          <span class="status-chip border-white/15 bg-white/5 text-white/75">Passive-first</span>
          <span class="status-chip border-white/15 bg-white/5 text-white/75">Evidence-linked</span>
        </div>
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-aqua">Atlas OT Scout · P0-WATER</p>
        <h1 class="mt-5 text-5xl font-bold leading-[1.02] tracking-[-0.045em] sm:text-6xl">Reconcile what OT records say with what the evidence supports.</h1>
        <p class="mt-7 text-lg leading-8 text-white/68">Atlas helps authorized assessors compare expected asset records with bounded field evidence, preserve uncertainty, and return a reviewed operating baseline.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="rounded-[9px] bg-blue px-5 py-3 text-sm font-bold text-white transition hover:bg-white hover:text-navy" href="#product">See the assessment flow</a>
          <a class="rounded-[9px] border border-aqua/45 px-5 py-3 text-sm font-bold text-white transition hover:bg-aqua/10 hover:text-aqua" href={`${base}pilot/`}>Evaluate Atlas</a>
        </div>
        <p class="mt-8 border-l-2 border-aqua pl-4 text-sm leading-6 text-white/52">Not a broad scanner. Not an exploitation framework. The product is built around bounded evidence questions and reviewed conclusions.</p>
      </div>
      <ProductMedia />
    </div>
  </section>

  <section id="product" class="scroll-mt-24 bg-surface">
    <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:py-24">
      <div class="grid gap-8 lg:grid-cols-[.72fr_1.28fr] lg:items-end">
        <div>
          <p class="section-label">The core problem</p>
          <h2 class="mt-3 text-4xl font-bold tracking-[-0.035em] sm:text-5xl">An asset register is a claim. Atlas tests how much of it the available evidence supports.</h2>
        </div>
        <p class="max-w-2xl text-lg leading-8 text-muted lg:justify-self-end">Expected records, packet evidence, physical context and exact authorized identity evidence are kept distinct until a reviewer accepts the relationship. Missing evidence is not silently converted into certainty.</p>
      </div>
      <div class="mt-12"><ReconciliationDiagram /></div>
    </div>
  </section>

  <section class="border-y border-border bg-white">
    <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8">
      <div class="grid gap-10 lg:grid-cols-[.9fr_1.1fr] lg:items-center">
        <div>
          <p class="section-label">One bounded assessment</p>
          <h2 class="mt-3 text-4xl font-bold tracking-[-0.035em]">Turn discrepancy into a reviewable operating baseline.</h2>
          <p class="mt-5 max-w-xl leading-7 text-muted">The golden pilot case is intentionally simple enough to understand at a glance and difficult enough to expose weak identity logic.</p>
          <div class="mt-7 app-frame bg-white p-5">
            <div class="flex items-center justify-between border-b border-border pb-4"><span class="text-sm font-bold">Golden assessment</span><span class="text-xs text-muted">18 expected assets</span></div>
            <div class="mt-4 grid grid-cols-2 gap-3 text-sm sm:grid-cols-5">
              <div class="rounded-[9px] bg-pale-teal p-3"><strong class="block text-2xl text-teal">12</strong><span class="text-muted">corroborated</span></div>
              <div class="rounded-[9px] bg-pale-blue p-3"><strong class="block text-2xl text-blue">2</strong><span class="text-muted">probable</span></div>
              <div class="rounded-[9px] border border-danger/35 bg-white p-3"><strong class="block text-2xl text-danger">1</strong><span class="text-muted">conflict</span></div>
              <div class="rounded-[9px] bg-pale-amber p-3"><strong class="block text-2xl text-amber">1</strong><span class="text-muted">unexpected</span></div>
              <div class="rounded-[9px] bg-surface p-3"><strong class="block text-2xl text-muted">2</strong><span class="text-muted">not observed</span></div>
            </div>
          </div>
        </div>
        <figure class="app-frame app-shadow overflow-hidden bg-white">
          <div class="flex items-center justify-between border-b border-border bg-white px-4 py-3"><span class="text-sm font-bold">Recorded Atlas workflow</span><span class="text-xs text-muted">real emulator output</span></div>
          <video class="block aspect-video w-full bg-navy object-cover" controls preload="metadata" playsinline poster={`${base}media/atlas-reconcile.jpg`}>
            <source src={`${base}media/atlas-ot-scout-demo.mp4`} type="video/mp4" />
          </video>
          <figcaption class="bg-surface px-4 py-3 text-xs leading-5 text-muted">The recording is composed from continuous Android application footage. It demonstrates only the behavior visible in that software environment.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="bg-surface">
    <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:py-24">
      <p class="section-label">Assessment workflow</p>
      <div class="mt-3 flex flex-wrap items-end justify-between gap-6">
        <h2 class="max-w-3xl text-4xl font-bold tracking-[-0.035em] sm:text-5xl">A controlled path from question to reviewed answer.</h2>
        <a class="text-sm font-bold text-blue hover:text-navy" href={`${base}safety/`}>Inspect the safety boundary →</a>
      </div>
      <ol class="mt-10 grid overflow-hidden rounded-[10px] border border-border md:grid-cols-5">
        {[
          ['01','Scope','Define the process area, assessment question, exclusions and authority.'],
          ['02','Evidence','Use imported, passive, physical or explicitly authorized active evidence.'],
          ['03','Review','Preserve source provenance and review observations before acceptance.'],
          ['04','Reconcile','Keep confirmed, probable, conflicting, unexpected and not-observed states explicit.'],
          ['05','Handoff','Return evidence, decisions, findings and limitations in a reviewed package.']
        ].map(([n,title,copy], i) => (
          <li class={`min-h-60 border-border p-5 ${i < 4 ? 'border-b md:border-b-0 md:border-r' : ''} ${i === 1 || i === 3 ? 'bg-white' : 'bg-surface'}`}>
            <span class="grid size-8 place-items-center rounded-[8px] bg-blue text-xs font-black text-white">{n}</span>
            <h3 class="mt-8 text-lg font-bold">{title}</h3>
            <p class="mt-3 text-sm leading-6 text-muted">{copy}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="bg-navy text-white">
    <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8">
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-aqua">Where Atlas creates value</p>
      <h2 class="mt-3 max-w-3xl text-4xl font-bold tracking-[-0.035em] sm:text-5xl">Use it where evidence can change a real operational decision.</h2>
      <div class="mt-10 grid gap-4 md:grid-cols-3">
        <article class="rounded-[10px] border border-aqua/20 bg-white/[.04] p-6"><span class="text-xs font-bold text-aqua">01</span><h3 class="mt-7 text-xl font-bold">Asset baseline reconciliation</h3><p class="mt-3 leading-7 text-white/58">Test whether field evidence supports the asset baseline currently accepted by operations.</p></article>
        <article class="rounded-[10px] border border-aqua/20 bg-white/[.04] p-6"><span class="text-xs font-bold text-aqua">02</span><h3 class="mt-7 text-xl font-bold">Commissioning &amp; handover</h3><p class="mt-3 leading-7 text-white/58">Expose identity and inventory discrepancies before project records become operational truth.</p></article>
        <article class="rounded-[10px] border border-aqua/20 bg-white/[.04] p-6"><span class="text-xs font-bold text-aqua">03</span><h3 class="mt-7 text-xl font-bold">Pre-maintenance baseline</h3><p class="mt-3 leading-7 text-white/58">Establish a bounded evidence-backed starting state before maintenance or modernization work.</p></article>
      </div>
    </div>
  </section>

  <section class="bg-surface">
    <div class="mx-auto grid max-w-7xl gap-8 px-5 py-20 sm:px-8 lg:grid-cols-[1fr_.9fr] lg:items-center">
      <div>
        <p class="section-label">Open engineering</p>
        <h2 class="mt-3 text-4xl font-bold tracking-[-0.035em]">Inspect the implementation, not just the website.</h2>
        <p class="mt-5 max-w-2xl leading-7 text-muted">Current capability, exact network behavior, threat controls and test evidence remain public and separately maintained.</p>
      </div>
      <div class="app-frame overflow-hidden bg-white">
        {[
          ['Current implementation',`${repo}/blob/main/IMPLEMENTATION.md`],
          ['Exact network execution',`${repo}/blob/main/docs/architecture/NETWORK-EXECUTION.md`],
          ['Security & threat model',`${repo}/blob/main/docs/architecture/SECURITY-AND-THREAT-MODEL.md`],
          ['Verification evidence',`${repo}/tree/main/docs/testing`],
          ['Source code',repo]
        ].map(([label,href], i) => <a class={`flex items-center justify-between px-5 py-4 text-sm font-bold transition hover:bg-pale-blue hover:text-blue ${i < 4 ? 'border-b border-border' : ''}`} href={href}><span>{label}</span><span aria-hidden="true">↗</span></a>)}
      </div>
    </div>
  </section>

  <section class="border-t border-border bg-white">
    <div class="mx-auto max-w-4xl px-5 py-20 text-center sm:px-8">
      <p class="section-label">Controlled evaluation</p>
      <h2 class="mt-3 text-4xl font-bold tracking-[-0.035em] sm:text-5xl">Start with one real OT evidence question.</h2>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-muted">A useful pilot is bounded to one process area, permitted evidence methods and a result that can change a customer decision.</p>
      <a class="mt-7 inline-block rounded-[9px] bg-blue px-6 py-3 text-sm font-bold text-white transition hover:bg-navy" href={`${base}pilot/`}>Review the customer pilot</a>
    </div>
  </section>
</SiteLayout>