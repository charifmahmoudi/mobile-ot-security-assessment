---
import SiteLayout from '../layouts/SiteLayout.astro';
import EvidenceFlowDiagram from '../components/EvidenceFlowDiagram.astro';
const base = import.meta.env.BASE_URL;
const repo = 'https://github.com/charifmahmoudi/mobile-ot-security-assessment';
---
<SiteLayout title="Safety & Trust — Atlas OT Scout" description="Atlas OT Scout uses explicit authorization, passive-first evidence collection, exact active operations, review boundaries and explicit limitations.">
  <section class="relative overflow-hidden bg-navy text-white">
    <div class="blueprint-grid absolute inset-0 opacity-45"></div>
    <div class="relative mx-auto grid max-w-7xl gap-10 px-5 py-16 sm:px-8 lg:grid-cols-[.85fr_1.15fr] lg:items-center lg:py-20">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-aqua">Safety &amp; Trust</p>
        <h1 class="mt-5 text-5xl font-bold leading-[1.04] tracking-[-0.045em] sm:text-6xl">Collect evidence without turning the assessment into uncontrolled network activity.</h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-white/66">Atlas separates imported and passive evidence from exact authorized active operations, then places review between observation and accepted conclusions.</p>
      </div>
      <figure class="app-frame app-shadow overflow-hidden border-white/15 bg-white">
        <img class="block aspect-video w-full object-cover" src={`${base}media/atlas-collect.jpg`} alt="Atlas OT Scout application during the recorded evidence collection workflow" />
        <figcaption class="flex items-center justify-between gap-3 border-t border-border bg-surface px-4 py-3 text-xs text-muted"><span>Actual recorded Atlas application</span><span class="font-bold text-blue">Collect → Review</span></figcaption>
      </figure>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8">
      <p class="section-label">Network and review boundary</p>
      <h2 class="mt-3 max-w-4xl text-4xl font-bold tracking-[-0.035em] sm:text-5xl">The evidence path is explicit.</h2>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-muted">The product should be able to explain where evidence came from, what network effect was authorized, what was reviewed, and what remains unresolved.</p>
      <div class="mt-10"><EvidenceFlowDiagram /></div>
    </div>
  </section>

  <section class="border-y border-border bg-surface">
    <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8">
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {[
          ['01','Authorization before transmission','Packet-producing behavior stays inside the approved case scope, exact target and compiled operation.'],
          ['02','Passive first','Imported or mirrored evidence is preferred whenever it can answer the documented question.'],
          ['03','Exact active operations','The initial active path is one Modbus Device Identification request to one authorized target—not a subnet or port scan.'],
          ['04','Evidence before conclusions','Raw observations and identity claims remain distinct from accepted inventory decisions.'],
          ['05','Offline workflow','Collection, reconciliation and handoff do not require a cloud service.'],
          ['06','Limitations stay visible','Insufficient visibility, conflicts and unresolved evidence remain part of the result.']
        ].map(([n,title,copy]) => (
          <article class="app-frame bg-white p-6">
            <span class="grid size-8 place-items-center rounded-[8px] bg-pale text-xs font-black text-blue">{n}</span>
            <h3 class="mt-7 text-xl font-bold">{title}</h3>
            <p class="mt-3 leading-7 text-muted">{copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto grid max-w-7xl gap-10 px-5 py-20 sm:px-8 lg:grid-cols-[.72fr_1.28fr]">
      <div>
        <p class="section-label">Technical review</p>
        <h2 class="mt-3 text-4xl font-bold tracking-[-0.035em]">Verify the boundaries in the repository.</h2>
        <p class="mt-5 leading-7 text-muted">This page is the short version. The exact execution and proof contracts remain inspectable.</p>
      </div>
      <div class="app-frame overflow-hidden bg-white">
        {[
          ['Current implementation','What executes today and what remains deferred.',`${repo}/blob/main/IMPLEMENTATION.md`],
          ['Network execution','Exact active/passive behavior, authorization and stop boundaries.',`${repo}/blob/main/docs/architecture/NETWORK-EXECUTION.md`],
          ['Security model','Threats, controls and residual risks.',`${repo}/blob/main/docs/architecture/SECURITY-AND-THREAT-MODEL.md`],
          ['Verification evidence','CI topology, testbeds and proof boundaries.',`${repo}/tree/main/docs/testing`]
        ].map(([title,copy,href], i) => (
          <a class={`grid gap-1 px-5 py-4 transition hover:bg-pale ${i < 3 ? 'border-b border-border' : ''}`} href={href}>
            <span class="flex items-center justify-between text-sm font-bold"><span>{title}</span><span>↗</span></span>
            <span class="text-sm leading-6 text-muted">{copy}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-pale">
    <div class="mx-auto max-w-5xl px-5 py-16 sm:px-8">
      <div class="app-frame border-blue/25 bg-white p-6 sm:p-8">
        <div class="flex flex-wrap items-start justify-between gap-5">
          <div class="max-w-3xl">
            <p class="section-label">Current product status</p>
            <h2 class="mt-3 text-2xl font-bold">P0-WATER is progressing toward controlled customer-pilot qualification.</h2>
            <p class="mt-4 leading-7 text-muted">Current executable capability and remaining release gates are published separately from the target pilot contract.</p>
          </div>
          <a class="rounded-[9px] bg-blue px-5 py-3 text-sm font-bold text-white hover:bg-navy" href={`${repo}/blob/main/IMPLEMENTATION.md`}>Current implementation ↗</a>
        </div>
      </div>
      <p class="mt-8 text-center text-sm text-muted">Considering a bounded evaluation? <a class="font-bold text-blue hover:text-navy" href={`${base}pilot/`}>Review the pilot model →</a></p>
    </div>
  </section>
</SiteLayout>
