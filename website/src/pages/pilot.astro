---
import SiteLayout from '../layouts/SiteLayout.astro';
const base = import.meta.env.BASE_URL;
const repo = 'https://github.com/charifmahmoudi/mobile-ot-security-assessment';
---
<SiteLayout title="Customer Pilot — Atlas OT Scout" description="A bounded Atlas evaluation starts with one OT evidence question, a defined process area, authorized evidence methods and a measurable customer decision.">
  <section class="relative overflow-hidden bg-navy text-white">
    <div class="blueprint-grid absolute inset-0 opacity-45"></div>
    <div class="relative mx-auto grid max-w-7xl gap-10 px-5 py-16 sm:px-8 lg:grid-cols-[.88fr_1.12fr] lg:items-center lg:py-20">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-aqua">Customer pilot</p>
        <h1 class="mt-5 text-5xl font-bold leading-[1.04] tracking-[-0.045em] sm:text-6xl">Start with one real OT evidence question.</h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-white/64">Example: <strong class="text-white">Does the installed control equipment in Pumping Area A match the inventory currently accepted by operations?</strong></p>
      </div>
      <figure class="app-frame app-shadow overflow-hidden border-aqua/20 bg-white">
        <img class="block aspect-video w-full object-cover" src={`${base}media/atlas-handoff.jpg`} alt="Atlas OT Scout application during the recorded assessment handoff workflow" />
        <figcaption class="flex items-center justify-between gap-3 border-t border-border bg-surface px-4 py-3 text-xs text-muted"><span>Actual recorded Atlas application</span><span class="font-bold text-blue">Review → Handoff</span></figcaption>
      </figure>
    </div>
  </section>

  <section class="bg-surface">
    <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8">
      <p class="section-label">Pilot path</p>
      <h2 class="mt-3 max-w-3xl text-4xl font-bold tracking-[-0.035em] sm:text-5xl">A customer decision, not an open-ended technology trial.</h2>
      <div class="mt-10 overflow-x-auto">
        <div class="grid min-w-[900px] grid-cols-7 items-stretch">
          {[
            ['01','Question','What must the assessment answer?'],
            ['02','Scope','Which exact process area is in bounds?'],
            ['03','Inventory','What baseline does the customer currently accept?'],
            ['04','Evidence','What collection methods are permitted?'],
            ['05','Reconcile','What is confirmed, probable, conflicting or missing?'],
            ['06','Review','Which conclusions does the assessor/reviewer accept?'],
            ['07','Deliver','What result changes the customer decision?']
          ].map(([n,title,copy], i) => (
            <div class="relative flex">
              <div class={`app-frame relative z-10 w-full bg-white p-4 ${i === 4 ? 'border-blue ring-2 ring-blue/20' : ''}`}>
                <span class="text-xs font-black text-blue">{n}</span>
                <h3 class="mt-5 font-bold">{title}</h3>
                <p class="mt-2 text-xs leading-5 text-muted">{copy}</p>
              </div>
              {i < 6 && <span class="absolute -right-3 top-1/2 z-20 grid size-6 -translate-y-1/2 place-items-center rounded-full bg-navy text-xs text-aqua">→</span>}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-border bg-white">
    <div class="mx-auto grid max-w-7xl gap-5 px-5 py-20 sm:px-8 lg:grid-cols-2">
      <div class="app-frame bg-white p-6 sm:p-7">
        <p class="section-label">Customer provides</p>
        <ul class="mt-6 divide-y divide-border">
          {['One defined site and process area','The existing accepted asset baseline','Operational context and responsible stakeholders','Approved evidence sources or capture access','Authorization, exclusions and stop conditions'].map((x,i) => <li class="flex gap-4 py-4 first:pt-0 last:pb-0"><span class="text-xs font-black text-blue">0{i+1}</span><span class="font-semibold">{x}</span></li>)}
        </ul>
      </div>
      <div class="app-frame overflow-hidden bg-navy text-white">
        <div class="border-b border-aqua/15 px-6 py-5"><p class="text-xs font-bold uppercase tracking-[0.14em] text-aqua">P0-WATER assessment unit</p></div>
        <div class="grid grid-cols-2">
          {[
            ['1','site / process area'],['1','L2 segment / VLAN'],['≤64','imported asset records'],['≤256','observed endpoints'],['≤16','allowlisted active targets'],['≤4h','field collection']
          ].map(([value,label],i) => <div class={`p-5 ${i % 2 === 0 ? 'border-r border-aqua/10' : ''} ${i < 4 ? 'border-b border-aqua/10' : ''}`}><strong class="text-3xl text-white">{value}</strong><span class="mt-2 block text-sm text-white/48">{label}</span></div>)}
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface">
    <div class="mx-auto grid max-w-7xl gap-10 px-5 py-20 sm:px-8 lg:grid-cols-[.72fr_1.28fr]">
      <div>
        <p class="section-label">Customer receives</p>
        <h2 class="mt-3 text-4xl font-bold tracking-[-0.035em]">A reviewed answer with the unresolved parts still visible.</h2>
      </div>
      <div class="app-frame overflow-hidden bg-white">
        {[
          ['Reconciled asset baseline','What the evidence supports now.'],
          ['Exceptions and unresolved questions','What still needs confirmation or correction.'],
          ['Evidence-linked findings','Material conditions tied back to supporting evidence.'],
          ['Visibility and assessment limitations','What was not observed, tested or supported.'],
          ['Active-operation ledger','Where an approved active identity operation was used.'],
          ['Reviewed assessment package','Human-readable and machine-readable handoff material.']
        ].map(([title,copy],i) => <div class={`grid gap-1 px-5 py-4 sm:grid-cols-[.8fr_1.2fr] sm:gap-6 ${i < 5 ? 'border-b border-border' : ''}`}><strong class="text-sm">{title}</strong><span class="text-sm leading-6 text-muted">{copy}</span></div>)}
      </div>
    </div>
  </section>

  <section class="bg-pale-blue">
    <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8">
      <div class="grid gap-6 lg:grid-cols-[1fr_.75fr] lg:items-center">
        <div>
          <p class="section-label">Success criterion</p>
          <h2 class="mt-3 max-w-4xl text-4xl font-bold tracking-[-0.035em] sm:text-5xl">Did Atlas produce a materially more trustworthy view of the bounded OT area than the customer started with?</h2>
          <p class="mt-5 max-w-3xl text-lg leading-8 text-muted">The pilot earns a continuation decision only if discrepancies become clearer, conclusions are inspectable, limitations are explicit, and the result improves a real operational or professional decision.</p>
        </div>
        <div class="app-frame bg-white p-6">
          <p class="text-sm font-bold">End-of-pilot decision</p>
          <div class="mt-4 grid gap-2 text-sm">
            <span class="rounded-[8px] bg-pale-teal px-4 py-3 font-bold text-teal">Continue</span>
            <span class="rounded-[8px] bg-pale-blue px-4 py-3 font-bold text-blue">Modify and retest</span>
            <span class="rounded-[8px] bg-surface px-4 py-3 font-bold text-muted">Investigate procurement / deployment fit</span>
            <span class="rounded-[8px] border border-danger/35 bg-white px-4 py-3 font-bold text-danger">Stop</span>
          </div>
          <div class="mt-5 flex flex-wrap gap-2"><a class="rounded-[9px] bg-blue px-4 py-2.5 text-sm font-bold text-white hover:bg-navy" href={`${repo}/blob/main/docs/business-development/OFFER.md`}>Evaluation terms ↗</a><a class="rounded-[9px] border border-border px-4 py-2.5 text-sm font-bold hover:bg-pale-blue" href={`${repo}/wiki`}>Wiki ↗</a></div>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>
